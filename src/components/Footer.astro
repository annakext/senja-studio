---
interface Props {
	fixed?: boolean;
}
const { fixed = true } = Astro.props;
---
<p class:list={fixed ? 'fixed bottom-1.5 right-6 z-10 text-[0.7rem] font-[325]' : 'mt-8 text-right text-[0.7rem] font-[325]'} style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #a0a09a;">© 2025 SENJA STUDIO. All rights reserved.</p>
