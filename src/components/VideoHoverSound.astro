---
interface Props {
	class?: string;
}
const { class: className = '' } = Astro.props;
---
<div class:list={['video-hover-sound group relative w-fit', className]}>
	<slot />
	<button
		type="button"
		class="sound-toggle absolute bottom-2 right-2 z-20 flex h-6 w-6 items-center justify-center rounded-full shadow-sm backdrop-blur-[2px]"
		style="background: rgba(0,0,0,0.4);"
		aria-label="Toggle sound"
	>
		<svg class="icon-on h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
			<path d="M4 9v6h4l5 5V4L8 9H4z" fill="#fff" />
			<path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v8.06c1.48-.74 2.5-2.26 2.5-4.03z" fill="#fff" />
			<path d="M14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z" fill="#fff" />
		</svg>
		<svg class="icon-off hidden h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
			<path d="M4 9v6h4l5 5V4L8 9H4z" fill="#fff" />
			<path d="M17 9l6 6M23 9l-6 6" stroke="#fff" stroke-width="1.8" stroke-linecap="round" />
		</svg>
	</button>
</div>
