---
export interface Props {
	active: 'projects' | 'services' | 'about' | 'contact';
	blend?: boolean;
	right?: string;
	left?: string;
	label?: string;
}
const { active, blend = false, right = 'right-6', left = 'left-6', label } = Astro.props;

const iconStyle = blend
	? 'color: #fff; mix-blend-mode: difference;'
	: 'color: #1c1c1c;';
const togglePositionClass = blend ? 'js-blend-fixed absolute' : 'fixed z-40';

const items = [
	{ key: 'services', label: 'I. services', href: '/services' },
	{ key: 'about', label: 'II. about', href: '/about' },
];
---

{label ? (
	<button
		id="mobile-menu-toggle"
		aria-label="Menu"
		class={`mobile-menu-toggle md:hidden ${togglePositionClass} ${right} text-[calc(0.76rem+1pt)] font-[325] uppercase`}
		style={`top: 19px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.05em; touch-action: manipulation; ${iconStyle}`}
	>{label}</button>
) : (
	<button
		id="mobile-menu-toggle"
		aria-label="Menu"
		class={`mobile-menu-toggle md:hidden ${togglePositionClass} ${right}`}
		style="top: 16px; width: 22px; touch-action: manipulation;"
	>
		<svg width="22" height="14" viewBox="0 0 22 14" fill="none" xmlns="http://www.w3.org/2000/svg" style={iconStyle}>
			<line x1="0" y1="1" x2="22" y2="1" stroke="currentColor" stroke-width="1.3" />
			<line x1="0" y1="7" x2="22" y2="7" stroke="currentColor" stroke-width="1.3" />
			<line x1="0" y1="13" x2="22" y2="13" stroke="currentColor" stroke-width="1.3" />
		</svg>
	</button>
)}

<div id="mobile-menu-overlay" class="md:hidden fixed inset-0 z-50 hidden" style="background-color: #fff;">
	<a
		id="site-logo-menu"
		href="/"
		class={`fixed top-3 ${left} block text-[41px] leading-tight font-normal`}
		style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.05em; color: #1c1c1c; text-transform: uppercase;"
	>senja studio</a>
	<button
		id="mobile-menu-close"
		aria-label="Close menu"
		class={`fixed z-50 ${right} text-[calc(0.76rem+1pt)] font-[325] uppercase`}
		style="top: 19px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.05em; touch-action: manipulation; color: #1c1c1c;"
	>close</button>
	<nav class="flex h-full flex-col justify-center gap-6 pl-6 text-[1.15rem] font-[325] lowercase" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c;">
		<div class="flex flex-col gap-1">
			{items.map((item) => (
				<a href={item.href} class={item.key === active ? 'italic' : ''}>{item.label}</a>
			))}
		</div>
		<p class="text-[0.85rem]"><span class="font-medium">let's work together</span><br /><a href="mailto:hello@senja.studio">hello@senja.studio</a></p>
		<a href="https://www.instagram.com/roll.bysenja/" target="_blank" rel="noopener noreferrer" class="flex flex-row items-center gap-2 text-[0.85rem]" aria-label="Instagram">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
				<rect x="2" y="2" width="20" height="20" rx="5" stroke="#1c1c1c" stroke-width="2" />
				<circle cx="12" cy="12" r="5" stroke="#1c1c1c" stroke-width="2" />
				<circle cx="18" cy="6" r="1.3" fill="#1c1c1c" />
			</svg>
			<span>roll.bysenja</span>
		</a>
	</nav>
</div>

<script>
	const toggle = document.getElementById('mobile-menu-toggle');
	const overlay = document.getElementById('mobile-menu-overlay');
	const closeBtn = document.getElementById('mobile-menu-close');
	const realLogo = document.getElementById('site-logo');
	const menuLogo = document.getElementById('site-logo-menu');
	const openMenu = () => {
		if (realLogo && menuLogo) {
			menuLogo.style.fontSize = getComputedStyle(realLogo).fontSize;
		}
		overlay?.classList.remove('hidden');
		document.body.style.overflow = 'hidden';
	};
	const closeMenu = () => {
		overlay?.classList.add('hidden');
		document.body.style.overflow = '';
	};
	toggle?.addEventListener('click', openMenu);
	closeBtn?.addEventListener('click', closeMenu);
</script>
