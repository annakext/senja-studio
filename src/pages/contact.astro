---
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>contact — SENJA STUDIO</title>
		<meta name="description" content="Get in touch with Senja Studio for visual content and brand image consultancy for hospitality and lifestyle brands." />
		<style>
			.nav-link { position: relative; text-decoration: none; }
			.nav-link::after { content: ""; position: absolute; left: 0; bottom: 1px; width: 0; height: 1px; background: currentColor; transition: width 0.3s ease; }
			.nav-link:hover::after { width: 100%; }
			.nav-link.active { color: #1c1c1c; }
			.nav-link.active::after { width: 100%; }
		</style>
	</head>
	<body>
		<div class="fixed top-3 left-6 right-6 z-10 flex flex-row items-start">
			<a href="/" class="block text-[41px] leading-tight font-normal" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.05em; color: #1c1c1c; text-transform: uppercase;">senja studio</a>
		</div>
		<nav class="fixed right-6 z-10 flex flex-row text-[0.76rem] font-[325]" style="top: 17px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c;">
			<a href="/" class="nav-link">projects</a><span>,&nbsp;</span><a href="/services" class="nav-link">services</a><span>,&nbsp;</span><a href="/about" class="nav-link">about</a><span>,&nbsp;</span><a href="/contact" class="nav-link active">contact</a>
		</nav>
		<a href="/" class="fixed left-6 z-10 text-2xl font-normal" style="top: 84px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1c1c1c; text-decoration: none;">←</a>


		<main class="min-h-screen px-6 pb-24 pt-28">
			<div class="ml-[29vw] max-w-xl">
				<p class="text-justify text-[0.8rem] font-[325] leading-relaxed" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c;"><span class="font-medium">let's work together</span><br /><a href="mailto:hello@senja.studio" class="transition-colors hover:text-neutral-400">hello@senja.studio</a></p>
				<a href="https://www.instagram.com/roll.bysenja/" target="_blank" rel="noopener noreferrer" class="mt-6 block w-fit" aria-label="Instagram">
					<svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
						<rect x="2" y="2" width="20" height="20" rx="5" stroke="#1c1c1c" stroke-width="2" />
						<circle cx="12" cy="12" r="5" stroke="#1c1c1c" stroke-width="2" />
						<circle cx="18" cy="6" r="1.3" fill="#1c1c1c" />
					</svg>
				</a>
				<a href="https://www.instagram.com/roll.bysenja/" target="_blank" rel="noopener noreferrer" class="mt-[5px] block text-[0.8rem] font-[325] transition-colors hover:text-neutral-400" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c;">roll.bysenja</a>
			</div>
		</main>

		<Footer />
	</body>
</html>
