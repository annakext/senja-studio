---
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>contact — senja studio</title>
		<style>
			.nav-link { position: relative; text-decoration: none; }
			.nav-link::after { content: ""; position: absolute; left: 0; bottom: 1px; width: 0; height: 1px; background: currentColor; transition: width 0.3s ease; }
			.nav-link:hover::after { width: 100%; }
			.nav-link.active { color: #1c1c1c; }
			.nav-link.active::after { width: 100%; }
		</style>
	</head>
	<body>
		<div class="fixed top-3 left-6 right-6 z-10 flex flex-row items-start">
			<a href="/" class="block text-[41px] leading-tight font-normal" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.05em; color: #1c1c1c; text-transform: uppercase;">senja studio</a>
		</div>
		<nav class="fixed right-6 z-10 flex flex-row text-[0.76rem] font-[325]" style="top: 17px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c;">
			<a href="/" class="nav-link">projects</a><span>,&nbsp;</span><a href="/services" class="nav-link">services</a><span>,&nbsp;</span><a href="/about" class="nav-link">about</a><span>,&nbsp;</span><a href="/contact" class="nav-link active">contact</a>
		</nav>
		<a href="https://www.instagram.com/roll.bysenja/" target="_blank" rel="noopener noreferrer" class="fixed right-6 z-10" style="top: 44px;" aria-label="Instagram">
			<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
				<rect x="2" y="2" width="20" height="20" rx="5" stroke="#1c1c1c" stroke-width="2" />
				<circle cx="12" cy="12" r="5" stroke="#1c1c1c" stroke-width="2" />
				<circle cx="18" cy="6" r="1.3" fill="#1c1c1c" />
			</svg>
		</a>

		<a href="/" class="fixed left-6 z-10 text-2xl font-normal" style="top: 84px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1c1c1c; text-decoration: none;">←</a>


		<main class="min-h-screen px-6 pb-24 pt-28">
			<div class="ml-[29vw] max-w-xl">
				<h1 class="relative block text-[25.33px] leading-tight font-normal" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c;">inquire</h1>
				<div class="mt-6 space-y-12 text-justify text-sm font-[325] leading-relaxed" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c;">

				<form id="contact-form" class="space-y-3 text-left" novalidate>
					<input type="text" name="name" placeholder="your name" class="w-full border-b border-neutral-300 bg-transparent pb-2 text-[0.8rem] outline-none placeholder:text-neutral-400 focus:border-[#1c1c1c]" />
					<input type="text" name="brand" placeholder="property / brand name" class="w-full border-b border-neutral-300 bg-transparent pb-2 text-[0.8rem] outline-none placeholder:text-neutral-400 focus:border-[#1c1c1c]" />
					<input type="text" name="venue" placeholder="type of venue" class="w-full border-b border-neutral-300 bg-transparent pb-2 text-[0.8rem] outline-none placeholder:text-neutral-400 focus:border-[#1c1c1c]" />
					<input type="text" name="location" placeholder="country and city" class="w-full border-b border-neutral-300 bg-transparent pb-2 text-[0.8rem] outline-none placeholder:text-neutral-400 focus:border-[#1c1c1c]" />
					<textarea name="message" placeholder="tell us about your project" rows="3" class="w-full resize-none border-b border-neutral-300 bg-transparent pb-2 text-[0.8rem] outline-none placeholder:text-neutral-400 focus:border-[#1c1c1c]"></textarea>
					<input type="text" name="_hp" style="position:absolute;left:-9999px" tabindex="-1" autocomplete="off" />
					<div id="turnstile-container" class="pt-2"></div>
					<div id="form-status"></div>
					<button type="submit" id="submit-btn" class="pt-2 text-sm font-medium transition-colors hover:text-neutral-400">SEND</button>
				</form>

				<script is:inline define:vars={{ siteKey: import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '' }}>
					(function() {
						const form = document.getElementById('contact-form');
						const btn = document.getElementById('submit-btn');
						const status = document.getElementById('form-status');
						let widgetId = null;

						if (siteKey) {
							const script = document.createElement('script');
							script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=__onTurnstileLoad';
							script.async = true;
							window.__onTurnstileLoad = function() {
								widgetId = window.turnstile.render('#turnstile-container', {
									sitekey: siteKey,
									theme: 'light',
									size: 'flexible',
								});
							};
							document.head.appendChild(script);
						}

						form.addEventListener('submit', async function(e) {
							e.preventDefault();
							btn.disabled = true;
							btn.textContent = 'sending…';
							status.textContent = '';
							status.style.color = '';

							const data = Object.fromEntries(new FormData(form));
							const token = widgetId != null ? window.turnstile.getResponse(widgetId) : '';

							if (siteKey && !token) {
								status.textContent = 'Please complete the verification.';
								status.style.color = '#a04040';
								btn.disabled = false;
								btn.textContent = 'SEND';
								return;
							}

							try {
								const res = await fetch('/api/contact', {
									method: 'POST',
									headers: { 'Content-Type': 'application/json' },
									body: JSON.stringify({ ...data, 'cf-turnstile-response': token }),
								});
								const result = await res.json();
								if (!res.ok) {
									status.textContent = result.error || 'Something went wrong.';
									status.style.color = '#a04040';
									if (widgetId != null) window.turnstile.reset(widgetId);
									btn.disabled = false;
									btn.textContent = 'SEND';
									return;
								}
								btn.style.display = 'none';
								status.textContent = 'Message sent — thank you.';
								status.style.color = '#4a7a3a';
								form.reset();
							} catch {
								status.textContent = 'Network error. Please try again.';
								status.style.color = '#a04040';
								if (widgetId != null) window.turnstile.reset(widgetId);
								btn.disabled = false;
								btn.textContent = 'SEND';
							}
						});
					})();
				</script>

				<p>or reach out directly at <a href="mailto:hello@senja.studio" class="font-medium transition-colors hover:text-neutral-400">hello@senja.studio</a></p>
				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>
