---
import '@fontsource/inter/200.css';
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '../styles/global.css';
import inter300 from '@fontsource/inter/files/inter-latin-300-normal.woff2?url';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import Footer from '../components/Footer.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preload" href={inter300} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital@0;1&display=swap" rel="stylesheet" />
		<title>SENJA STUDIO</title>
		<style>
			#htrack figure { transform: translateX(0); transition: transform 0.45s ease; }
			#htrack figure.is-before { transform: translateX(0); }
			#htrack figure.is-after { transform: translateX(0); }
			#htrack .photo-visual { filter: grayscale(1) contrast(0.63) brightness(1.14); transform: scale(1); transform-origin: top; transition: filter 0.45s ease, transform 0.45s ease; }
			#htrack figure.is-active .photo-visual { filter: grayscale(0); z-index: 5; }
			#htrack figure { position: relative; }
			#htrack figure::after { content: ""; position: absolute; inset: 0; background: rgba(255, 255, 255, 0.25); pointer-events: none; transition: opacity 0.45s ease; }
			#htrack figure.is-active::after { opacity: 0.12; }
			#htrack .photo-num { transition: opacity 0.45s ease; }
			#htrack figure.is-active .photo-num { opacity: 0; }
			#htrack .photo-visual a { cursor: default; }
			.big-preview-img { transition: opacity 1s ease; }
			#idx-table p { transition: color 0.4s ease; }
			#idx-table p.on { color: #1c1c1c; }
			.nav-link { position: relative; text-decoration: none; }
			.nav-link.fixed { position: fixed; }
			.nav-link::after { content: ""; position: absolute; left: 0; bottom: 1px; width: 0; height: 1px; background: currentColor; transition: width 0.3s ease; }
			.nav-link:hover::after { width: 100%; }
			.nav-link.active { color: #1c1c1c; }
			.nav-link.active::after { width: 100%; }
		</style>
	</head>
	<body class="reveal-page">
				<div class="fixed top-3 left-6 right-6 z-10 flex flex-row items-start">
			<a href="/" class="block text-[41px] leading-tight font-normal" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.05em; color: #1c1c1c; text-transform: uppercase;">senja studio</a>
		</div>
		<div id="header-tagline" class="fixed top-3 left-1/2 z-10">
			<p class="text-[0.76rem] font-[325]" style="margin-top: 7px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.15;">visual content studio and brand image consultancy<br />for luxury hospitality and lifestyle brands.<br />film. photography. creative direction.</p>
		</div>
		<nav class="fixed right-6 z-10 flex flex-row text-[0.76rem] font-[325]" style="top: 17px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c;">
			<a href="/" class="nav-link active">projects</a><span>,&nbsp;</span><a href="/services" class="nav-link">services</a><span>,&nbsp;</span><a href="/about" class="nav-link">about</a><span>,&nbsp;</span><a href="/contact" class="nav-link">contact</a>
		</nav>
