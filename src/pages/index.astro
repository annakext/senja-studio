		<script>
			const bigImg = document.getElementById('projects-big-img');
			const defaultBigSrc = bigImg ? bigImg.getAttribute('src') : '';
			const captionInner = document.getElementById('caption-inner');
			const defaultTitle1 = 'VILLA CONNEXION';
			const defaultTitle2 = 'intimate luxurious spaces';
			const pageInner = document.getElementById('projects-page-inner');
			const defaultPage = '1/4';

			const ROLL_MS = 900;
			const rollTo = (innerEl, html) => {
				if (!innerEl || innerEl.dataset.current === html) return;
				innerEl.dataset.current = html;
				const wrap = innerEl.parentElement;
				const step = wrap.getBoundingClientRect().height;

				Array.from(wrap.querySelectorAll('.roll-old')).forEach((el) => el.remove());
				if (innerEl._anim) innerEl._anim.cancel();

				const old = innerEl.cloneNode(true);
				old.removeAttribute('id');
				old.classList.add('roll-old');
				old.style.position = 'absolute';
				old.style.top = '0';
				old.style.left = '0';
				old.style.right = '0';
				wrap.appendChild(old);
				old.animate(
					[
						{ transform: 'translateY(0px)', color: '#1c1c1c' },
						{ transform: 'translateY(-' + step + 'px)', color: '#c4c4c4' },
					],
					{ duration: ROLL_MS, easing: 'ease', fill: 'forwards' }
				).onfinish = () => old.remove();

				innerEl.innerHTML = html;
				innerEl.style.position = 'relative';
				innerEl._anim = innerEl.animate(
					[
						{ transform: 'translateY(' + step + 'px)', color: '#c4c4c4' },
						{ transform: 'translateY(0px)', color: '#1c1c1c' },
					],
					{ duration: ROLL_MS, easing: 'ease', fill: 'forwards' }
				);
			};

			const allThumbs = Array.from(document.querySelectorAll('.projects-thumb'));
			const thumb1 = allThumbs.find((t) => t.dataset.page === '1/4');

			const setVeil = (thumb, on) => {
				const veilEl = thumb.querySelector('.thumb-veil');
				const imgEl = thumb.querySelector('img');
				if (veilEl) {
					if (veilEl._anim) veilEl._anim.cancel();
					const from = Number(getComputedStyle(veilEl).opacity) || 0;
					veilEl.style.opacity = on ? '1' : '0';
					veilEl._anim = veilEl.animate(
						[
							{ opacity: from, backgroundColor: 'rgba(255,255,255,0.75)' },
							{ opacity: on ? 1 : from / 2, backgroundColor: 'rgba(255,255,255,0.92)', offset: 0.5 },
							{ opacity: on ? 1 : 0, backgroundColor: 'rgba(255,255,255,0.75)' },
						],
						{ duration: 300, easing: 'ease', fill: 'forwards' }
					);
				}
				if (imgEl) imgEl.style.filter = on ? 'grayscale(1)' : 'none';
			};

			let activeThumb = thumb1;

			const setActive = (thumb) => {
				if (thumb === activeThumb) return;
				const title1 = thumb.dataset.title1 || defaultTitle1;
				const title2 = thumb.dataset.title2 || defaultTitle2;
				const page = thumb.dataset.page || defaultPage;
				if (bigImg) {
					if (bigImg._fadeOverlay) {
						bigImg._fadeOverlay.remove();
						bigImg._fadeOverlay = null;
					}
					if (bigImg._flashOverlay) {
						bigImg._flashOverlay.remove();
						bigImg._flashOverlay = null;
					}
					const overlay = bigImg.cloneNode(true);
					overlay.removeAttribute('id');
					overlay.style.pointerEvents = 'none';
					overlay.style.opacity = '0';
					overlay.src = thumb.dataset.img;
					bigImg.insertAdjacentElement('afterend', overlay);
					bigImg._fadeOverlay = overlay;

					const flash = document.createElement('div');
					flash.className = bigImg.className;
					flash.style.background = '#fff';
					flash.style.opacity = '0';
					flash.style.pointerEvents = 'none';
					overlay.insertAdjacentElement('afterend', flash);
					bigImg._flashOverlay = flash;
					flash.animate(
						[{ opacity: 0, offset: 0 }, { opacity: 0.18, offset: 0.5 }, { opacity: 0, offset: 0.85 }, { opacity: 0, offset: 1 }],
						{ duration: ROLL_MS, easing: 'ease-in-out', fill: 'forwards' }
					).onfinish = () => {
						flash.remove();
						if (bigImg._flashOverlay === flash) bigImg._flashOverlay = null;
					};

					overlay.animate(
						[{ opacity: 0 }, { opacity: 1 }],
						{ duration: ROLL_MS, easing: 'ease', fill: 'forwards' }
					).onfinish = () => {
						bigImg.src = thumb.dataset.img;
						overlay.remove();
						if (bigImg._fadeOverlay === overlay) bigImg._fadeOverlay = null;
					};
				}
				rollTo(captionInner, title1 + '<br />' + title2);
				rollTo(pageInner, page);
				if (activeThumb) setVeil(activeThumb, true);
				setVeil(thumb, false);
				activeThumb = thumb;
			};

			allThumbs.forEach((thumb) => {
				thumb.addEventListener('mouseenter', () => setActive(thumb));
			});

			const connectorLine = document.getElementById('projects-connector-line');
			const placeConnectorLine = () => {
				const h1 = Array.from(document.querySelectorAll('h1')).find((x) => x.textContent.trim() === 'projects');
				const firstThumb = document.querySelector('.projects-thumb');
				if (!connectorLine || !h1 || !bigImg || !firstThumb) return;
				const h1Rect = h1.getBoundingClientRect();
				const bigRect = bigImg.getBoundingClientRect();
				const thumbRect = firstThumb.getBoundingClientRect();
				connectorLine.style.left = h1Rect.right + 'px';
				connectorLine.style.top = bigRect.top + 'px';
				const lineRight = thumbRect.left + bigRect.width;
				connectorLine.style.width = (lineRight - h1Rect.right) + 'px';

				const gap = 4.5;
				const captionWrap = document.getElementById('caption-wrap');
				if (captionWrap) {
					captionWrap.style.left = h1Rect.right + 'px';
					captionWrap.style.top = (bigRect.top + gap) + 'px';
				}

				const pageIndicator = document.getElementById('projects-page-indicator');
				if (pageIndicator) {
					pageIndicator.style.right = (window.innerWidth - lineRight) + 'px';
					pageIndicator.style.top = (bigRect.top + gap) + 'px';
				}

				const countryCol = document.getElementById('idx-country-col');
				if (countryCol && countryCol.parentElement) {
					const wrapperRect = countryCol.parentElement.getBoundingClientRect();
					countryCol.style.left = (lineRight - wrapperRect.left) + 'px';
					countryCol.style.transform = 'none';
				}
			};
			placeConnectorLine();
			window.addEventListener('resize', placeConnectorLine);
			window.addEventListener('load', placeConnectorLine);

			const main = document.getElementById('hscroll');
			const track = document.getElementById('htrack');
			const figs = Array.from(track.querySelectorAll('figure'));
			const numEl = document.getElementById('idx-num');
			const themeEl = document.getElementById('idx-theme');
			const listEl = document.getElementById('idx-list');
			const rows = listEl ? Array.from(listEl.querySelectorAll('p[data-i]')) : [];
			const themes = ['XX', 'YY', 'ZZ', 'AA', 'BB', 'CC'];
			const N = 12;
			const ROW = 1.2;
			let centers = [];
			let vw = 0;
			let setWidth = 1;
			let target = 0;
			let current = 0;
			let activeBi = -1;
			let activeM = -1;
			let reelIdx = N;
			let prevCountry = 0;
			let idle = 0;
			let snapped = false;
			const measure = () => {
				centers = figs.map((f) => f.offsetLeft + f.offsetWidth / 2);
				vw = window.innerWidth;
				setWidth = (figs[N].offsetLeft - figs[0].offsetLeft) || 1;
			};
			measure();
			window.addEventListener('resize', measure);
			window.addEventListener('load', measure);
			if (window.ResizeObserver) {
				new ResizeObserver(measure).observe(track);
			}
			main.addEventListener('wheel', (e) => {
				e.preventDefault();
				let d = Math.abs(e.deltaY) > Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
				if (e.deltaMode === 1) d *= 16;
				else if (e.deltaMode === 2) d *= vw;
				target += d;
				idle = 0;
				snapped = false;
			}, { passive: false });
			const placeReel = () => {
				listEl.style.transform = 'translateY(' + ((4 - reelIdx) * ROW) + 'em)';
				rows.forEach((r) => r.classList.toggle('on', Number(r.dataset.i) === reelIdx));
			};
			const setReel = (country) => {
				let diff = country - prevCountry;
				if (diff > N / 2) diff -= N;
				if (diff < -N / 2) diff += N;
				reelIdx += diff;
				prevCountry = country;
				if (reelIdx < N || reelIdx >= 2 * N) {
					reelIdx = N + (((reelIdx % N) + N) % N);
				}
				placeReel();
			};
			const updateActive = (vis) => {
				const targetPos = vis + vw / 2;
				let bi = 0;
				let bd = Infinity;
				for (let i = 0; i < centers.length; i++) {
					const dd = Math.abs(centers[i] - targetPos);
					if (dd < bd) { bd = dd; bi = i; }
				}
				if (bi !== activeBi) {
						activeBi = bi;
						for (let i = 0; i < figs.length; i++) {
							figs[i].classList.toggle('is-active', i === bi);
							figs[i].classList.toggle('is-before', i < bi);
							figs[i].classList.toggle('is-after', i > bi);
						}
						const m = bi % N;
						if (m !== activeM) {
							activeM = m;
							if (numEl) numEl.textContent = String(m + 1).padStart(2, '0');
							if (themeEl) themeEl.textContent = themes[m % themes.length];
							setReel(m);
						}
					}

				return centers[bi] - targetPos;
			};
			placeReel();
			const raf = () => {
				current += (target - current) * 0.08;
				const vis = (((current % setWidth) + setWidth) % setWidth);
				track.style.transform = 'translate3d(' + (-vis) + 'px, 0, 0)';
				const bestD = updateActive(vis);
				idle++;
				if (!snapped && idle > 8 && Math.abs(target - current) < 1.5) {
					target += bestD;
					snapped = true;
				}
				requestAnimationFrame(raf);
			};
			requestAnimationFrame(raf);
		</script>






