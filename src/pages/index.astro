		<script>
			const bigImg = document.getElementById('projects-big-img');
			const defaultBigSrc = bigImg ? bigImg.getAttribute('src') : '';
			const captionLine1Inner = document.getElementById('caption-line1-inner');
			const captionLine2Inner = document.getElementById('caption-line2-inner');
			const defaultTitle1 = 'VILLA CONNEXION';
			const defaultTitle2 = 'intimate luxurious spaces';
			const pageInner = document.getElementById('projects-page-inner');
			const defaultPage = '1/4';

			const rollTo = (innerEl, html) => {
				if (!innerEl || innerEl.dataset.current === html) return;
				innerEl.dataset.current = html;
				const wrap = innerEl.parentElement;
				const step = wrap.getBoundingClientRect().height;
				const old = innerEl.cloneNode(true);
				old.removeAttribute('id');
				old.style.position = 'absolute';
				old.style.top = '0';
				old.style.left = '0';
				old.style.right = '0';
				old.style.transform = 'translateY(0px)';
				old.style.color = '#1c1c1c';
				old.style.transition = 'transform 0.75s ease, color 0.75s ease';
				old.style.backfaceVisibility = 'hidden';
				wrap.appendChild(old);

				innerEl.innerHTML = html;
				innerEl.style.position = 'relative';
				innerEl.style.transform = 'translateY(' + step + 'px)';
				innerEl.style.color = '#c4c4c4';
				innerEl.style.transition = 'none';
				innerEl.style.backfaceVisibility = 'hidden';
				void innerEl.offsetHeight;
				innerEl.style.transition = 'transform 0.75s ease, color 0.75s ease';
				requestAnimationFrame(() => {
					old.style.transform = 'translateY(-' + step + 'px)';
					old.style.color = '#c4c4c4';
					innerEl.style.transform = 'translateY(0px)';
					innerEl.style.color = '#1c1c1c';
				});
				setTimeout(() => { old.remove(); }, 770);
			};

			const allThumbs = Array.from(document.querySelectorAll('.projects-thumb'));
			const thumb1 = allThumbs.find((t) => t.dataset.page === '1/4');
			const thumb1Veil = thumb1 ? thumb1.querySelector('.thumb-veil') : null;
			const thumb1Img = thumb1 ? thumb1.querySelector('img') : null;

			const setVeil = (veilEl, imgEl, on) => {
				if (veilEl) veilEl.style.opacity = on ? '1' : '0';
				if (imgEl) imgEl.style.filter = on ? 'grayscale(1)' : 'none';
			};

			allThumbs.forEach((thumb) => {
				const src = thumb.dataset.img;
				const title1 = thumb.dataset.title1 || defaultTitle1;
				const title2 = thumb.dataset.title2 || defaultTitle2;
				const page = thumb.dataset.page || defaultPage;
				const isDefault = thumb === thumb1;
				const veil = thumb.querySelector('.thumb-veil');
				const img = thumb.querySelector('img');
				thumb.addEventListener('mouseenter', () => {
					if (bigImg) bigImg.src = src;
					rollTo(captionLine1Inner, title1);
					rollTo(captionLine2Inner, title2);
					rollTo(pageInner, page);
					if (!isDefault) {
						setVeil(veil, img, false);
						setVeil(thumb1Veil, thumb1Img, true);
					}
				});
				thumb.addEventListener('mouseleave', () => {
					if (bigImg) bigImg.src = defaultBigSrc;
					rollTo(captionLine1Inner, defaultTitle1);
					rollTo(captionLine2Inner, defaultTitle2);
					rollTo(pageInner, defaultPage);
					if (!isDefault) {
						setVeil(veil, img, true);
						setVeil(thumb1Veil, thumb1Img, false);
					}
				});
			});

			const connectorLine = document.getElementById('projects-connector-line');
			const placeConnectorLine = () => {
				const h1 = Array.from(document.querySelectorAll('h1')).find((x) => x.textContent.trim() === 'projects');
				const taglineP = Array.from(document.querySelectorAll('p')).find((x) => x.textContent.includes('visual content studio'));
				if (!connectorLine || !h1 || !bigImg || !taglineP) return;
				const textNode = Array.from(taglineP.childNodes).find((n) => n.nodeType === 3 && n.textContent.includes('consultancy'));
				const idx = textNode.textContent.indexOf('consultancy');
				const range = document.createRange();
				range.setStart(textNode, idx);
				range.setEnd(textNode, idx + 'consultancy'.length);
				const consultancyRect = range.getBoundingClientRect();
				const h1Rect = h1.getBoundingClientRect();
				const bigRect = bigImg.getBoundingClientRect();
				connectorLine.style.left = h1Rect.right + 'px';
				connectorLine.style.top = bigRect.top + 'px';
				connectorLine.style.width = (consultancyRect.right - h1Rect.right + 12) + 'px';

				const gap = 4.5;
				const lineWrapHeight = 14;
				const captionLine1Wrap = document.getElementById('caption-line1-wrap');
				const captionLine2Wrap = document.getElementById('caption-line2-wrap');
				if (captionLine1Wrap) {
					captionLine1Wrap.style.left = h1Rect.right + 'px';
					captionLine1Wrap.style.top = (bigRect.top + gap) + 'px';
				}
				if (captionLine2Wrap) {
					captionLine2Wrap.style.left = h1Rect.right + 'px';
					captionLine2Wrap.style.top = (bigRect.top + gap + lineWrapHeight) + 'px';
				}

				const lineRight = h1Rect.right + parseFloat(connectorLine.style.width);
				const pageIndicator = document.getElementById('projects-page-indicator');
				if (pageIndicator) {
					pageIndicator.style.right = (window.innerWidth - lineRight) + 'px';
					pageIndicator.style.top = (bigRect.top + gap) + 'px';
				}
			};
			placeConnectorLine();
			window.addEventListener('resize', placeConnectorLine);
			window.addEventListener('load', placeConnectorLine);

			const main = document.getElementById('hscroll');
			const track = document.getElementById('htrack');
			const figs = Array.from(track.querySelectorAll('figure'));
			const numEl = document.getElementById('idx-num');
			const themeEl = document.getElementById('idx-theme');
			const listEl = document.getElementById('idx-list');
			const rows = listEl ? Array.from(listEl.querySelectorAll('p[data-i]')) : [];
			const themes = ['XX', 'YY', 'ZZ', 'AA', 'BB', 'CC'];
			const N = 18;
			const ROW = 1.2;
			let centers = [];
			let vw = 0;
			let setWidth = 1;
			let target = 0;
			let current = 0;
			let activeBi = -1;
			let activeM = -1;
			let reelIdx = N;
			let prevCountry = 0;
			let idle = 0;
			let snapped = false;
			const measure = () => {
				centers = figs.map((f) => f.offsetLeft + f.offsetWidth / 2);
				vw = window.innerWidth;
				setWidth = (figs[N].offsetLeft - figs[0].offsetLeft) || 1;
			};
			measure();
			window.addEventListener('resize', measure);
			window.addEventListener('load', measure);
			if (window.ResizeObserver) {
				new ResizeObserver(measure).observe(track);
			}
			main.addEventListener('wheel', (e) => {
				e.preventDefault();
				let d = Math.abs(e.deltaY) > Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
				if (e.deltaMode === 1) d *= 16;
				else if (e.deltaMode === 2) d *= vw;
				target += d;
				idle = 0;
				snapped = false;
			}, { passive: false });
			const placeReel = () => {
				listEl.style.transform = 'translateY(' + ((4 - reelIdx) * ROW) + 'em)';
				rows.forEach((r) => r.classList.toggle('on', Number(r.dataset.i) === reelIdx));
			};
			const setReel = (country) => {
				let diff = country - prevCountry;
				if (diff > N / 2) diff -= N;
				if (diff < -N / 2) diff += N;
				reelIdx += diff;
				prevCountry = country;
				if (reelIdx < N || reelIdx >= 2 * N) {
					reelIdx = N + (((reelIdx % N) + N) % N);
				}
				placeReel();
			};
			const updateActive = (vis) => {
				const targetPos = vis + vw / 2;
				let bi = 0;
				let bd = Infinity;
				for (let i = 0; i < centers.length; i++) {
					const dd = Math.abs(centers[i] - targetPos);
					if (dd < bd) { bd = dd; bi = i; }
				}
				if (bi !== activeBi) {
						activeBi = bi;
						for (let i = 0; i < figs.length; i++) {
							figs[i].classList.toggle('is-active', i === bi);
							figs[i].classList.toggle('is-before', i < bi);
							figs[i].classList.toggle('is-after', i > bi);
						}
						const m = bi % N;
						if (m !== activeM) {
							activeM = m;
							if (numEl) numEl.textContent = String(m + 1).padStart(2, '0');
							if (themeEl) themeEl.textContent = themes[m % themes.length];
							setReel(m);
						}
					}

				return centers[bi] - targetPos;
			};
			placeReel();
			const raf = () => {
				current += (target - current) * 0.08;
				const vis = (((current % setWidth) + setWidth) % setWidth);
				track.style.transform = 'translate3d(' + (-vis) + 'px, 0, 0)';
				const bestD = updateActive(vis);
				idle++;
				if (!snapped && idle > 8 && Math.abs(target - current) < 1.5) {
					target += bestD;
					snapped = true;
				}
				requestAnimationFrame(raf);
			};
			requestAnimationFrame(raf);
		</script>






	</body>
</html>
