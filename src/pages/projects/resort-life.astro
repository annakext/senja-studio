---
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '../../styles/global.css';
import Footer from '../../components/Footer.astro';
import VideoHoverSound from '../../components/VideoHoverSound.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>resort life — SENJA STUDIO</title>
		<meta name="description" content="Resort Life — stillness and light, visual content by Senja Studio for hospitality and lifestyle brands." />
		<style>
			:global(html), :global(body) { overflow: auto; height: auto; min-height: 100%; background: #fff; }
			:global(body) { position: relative; }
			.nav-link { position: relative; text-decoration: none; }
			.nav-link.fixed { position: fixed; }
			.nav-link::after { content: ""; position: absolute; left: 0; bottom: 1px; width: 0; height: 1px; background: currentColor; transition: width 0.3s ease; }
			.nav-link:hover::after { width: 100%; }
			.nav-link.active::after { width: 100%; }
		</style>
	</head>
	<body>
		<div style="position: absolute; inset: 0; z-index: -1; background: #fff;"></div>
		<main class="min-h-screen px-6 pb-24 pt-48 reveal-page">
			<div id="rl-row7" class="relative mt-[-25px] ml-[709px] flex w-fit flex-row items-end gap-4">
				<img id="rl-img7" src="/images/resort-life/7.webp" alt="" class="w-[300px] aspect-[4/5] object-cover" loading="lazy" />
				<div id="rl-text-col" class="absolute flex h-[400px] flex-col justify-between">
					<p id="rl-text" class="max-w-[220px] text-[0.76rem] font-[325] text-justify" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.5;">A resort is experienced as a sequence of spaces rather than a collection of rooms. Pools, lobbies, restaurants and quiet corners shape the rhythm of a stay as much as the accommodation itself. Through careful attention to light, texture and materials, these images explore the character of a place and the quiet experience it offers.</p>
				</div>
				<img id="rl-img8bis" src="/images/resort-life/8bis.webp" alt="" class="absolute w-[110px] h-[157px] object-cover object-bottom" loading="lazy" />
				<div id="rl-row11-wrap" class="absolute flex flex-row gap-2">
					<img src="/images/resort-life/11qua.webp" alt="" class="w-[183px] aspect-[9/16] object-cover brightness-105" loading="lazy" />
					<img src="/images/resort-life/12ter.webp" alt="" class="w-[183px] aspect-[9/16] object-cover brightness-105" loading="lazy" />
					<img id="rl-img13bis" src="/images/resort-life/13bis.webp" alt="" class="w-[183px] aspect-[9/16] object-cover brightness-105" loading="lazy" />
				</div>
				<p id="rl-deliverables" class="absolute w-fit whitespace-nowrap text-right text-[0.76rem] font-[325]" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.5;"><span class="mr-4 italic lowercase">deliverables</span>instagram feed · reels · stories · website imagery · paid ads</p>
			</div>

			<div id="rl-row9" class="relative mt-2 ml-[772px] flex flex-row items-end gap-2">
				<p id="rl-services" class="absolute text-[0.76rem] font-[325] text-right" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.5;"><span class="italic lowercase">services</span><br /><br />concept<br />creative direction<br />photography<br />film<br />ugc<br />post-production<br />content strategy</p>
				<VideoHoverSound>
					<video id="rl-video14" src="/videos/resort-life-14.mp4" class="w-[215px] aspect-[9/16] object-cover" autoplay loop muted playsinline></video>
				</VideoHoverSound>
			</div>

			<div id="rl-img16-wrap" class="relative mt-2 ml-[562px] w-[98px] h-[116px]">
				<img id="rl-img16" src="/images/resort-life/16.webp" alt="" class="h-full w-full object-cover brightness-105 [transform:scaleX(-1)]" loading="lazy" />
				<div class="pointer-events-none absolute inset-0 bg-white/[0.03]"></div>
			</div>

			<div id="rl-row14" class="relative mt-[58px] flex w-fit flex-row items-end gap-2">
				<div id="rl-img3" class="absolute w-[155px] aspect-[3/4]">
					<img src="/images/resort-life/3.webp" alt="" class="h-full w-full rounded-[8px] object-cover" loading="lazy" />
					<div class="pointer-events-none absolute inset-0 rounded-[8px] bg-white/[0.1]"></div>
				</div>
				<div id="rl-img2" class="absolute h-[116px] aspect-[16/9]">
					<img src="/images/resort-life/2.webp" alt="" class="h-full w-full object-cover brightness-95" loading="lazy" />
					<div class="pointer-events-none absolute inset-0 bg-white/[0.08]"></div>
				</div>
				<img id="rl-img9bis" src="/images/resort-life/9bis.webp" alt="" class="absolute w-[275px] aspect-[3/4] object-cover" loading="lazy" />
				<img id="rl-img17-visual" src="/images/resort-life/17.webp" alt="" class="w-[98px] h-[116px] object-cover" loading="lazy" />
				<img src="/images/resort-life/4.webp" alt="" class="w-[98px] h-[116px] object-cover" loading="lazy" />
				<img src="/images/resort-life/5.webp" alt="" class="w-[98px] h-[116px] object-cover" loading="lazy" />
				<img id="rl-img6bis" src="/images/resort-life/6bis.webp" alt="" class="w-[98px] h-[116px] object-cover" loading="lazy" />
			</div>

			<div id="rl-row-video" class="mt-2 ml-[147px] flex w-fit flex-row items-end gap-2">
				<VideoHoverSound>
					<video id="rl-video" src="/videos/resort-life-1.mp4" class="w-[420px] h-[299px] rounded-[12px] object-cover brightness-115" autoplay loop muted playsinline></video>
				</VideoHoverSound>
			</div>

			<a href="/projects/curated-places" class="mt-16 block pt-6" style="border-top: 0.5px solid #1c1c1c;">
				<p class="text-[0.76rem] font-[325] uppercase" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.08em; color: #8c8a84;">Next</p>
				<p class="mt-1 text-[calc(0.76rem+2pt)] font-[325] tabular-nums" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.15;">3/4<br />CURATED PLACES<br />lifestyle, food and culture</p>
			</a>
		</main>

		<div class="js-blend-fixed absolute top-3 left-6 right-6 flex flex-row items-start">
			<a id="site-logo" href="/" class="block text-[41px] leading-tight font-normal" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.05em; color: #fff; mix-blend-mode: difference; text-transform: uppercase;">senja studio</a>
		</div>
		<div class="absolute top-3 left-1/2 z-10 w-1/2 pointer-events-none">
			<p class="text-[0.76rem] font-[325]" style="margin-top: 7px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.15;">2/4<br />RESORT LIFE<br />stillness and light</p>
		</div>
		<nav class="js-blend-fixed absolute right-6 flex flex-row text-[0.76rem] font-[325]" style="top: 17px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #fff; mix-blend-mode: difference;">
			<a href="/" class="nav-link active">projects</a><span>,&nbsp;</span><a href="/services" class="nav-link">services</a><span>,&nbsp;</span><a href="/about" class="nav-link">about</a><span>,&nbsp;</span><a href="/contact" class="nav-link">contact</a>
		</nav>
		<a href="/" class="fixed left-6 z-10 text-2xl font-normal" style="top: 84px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1c1c1c; text-decoration: none;">←</a>

		<Footer fixed={false} />
		<script>
			import { initHoverSoundVideos } from '../../scripts/video-hover-sound.js';
			import { initResponsiveLogo } from '../../scripts/responsive-logo.js';
			initHoverSoundVideos();
			initResponsiveLogo();

			const blendFixedEls = Array.from(document.querySelectorAll('.js-blend-fixed')).map((el) => ({
				el,
				offset: parseFloat(getComputedStyle(el).top) || 0,
			}));
			const syncBlendFixed = () => {
				blendFixedEls.forEach(({ el, offset }) => {
					el.style.top = (window.scrollY + offset) + 'px';
				});
			};
			syncBlendFixed();
			window.addEventListener('scroll', syncBlendFixed, { passive: true });
			window.addEventListener('resize', syncBlendFixed);

			const layoutRows = () => {
				const img7 = document.getElementById('rl-img7');
				const row7 = document.getElementById('rl-row7');
				const video14 = document.getElementById('rl-video14');
				const video14Wrap = video14 ? video14.parentElement : null;
				const nav = document.querySelector('nav');
				if (nav && video14 && video14Wrap) {
					const currentML = parseFloat(getComputedStyle(video14Wrap).marginLeft) || 0;
					const width = video14.getBoundingClientRect().width;
					video14Wrap.style.marginLeft = (currentML + (nav.getBoundingClientRect().right - width - video14.getBoundingClientRect().left) - 103) + 'px';
				}
				const row9 = document.getElementById('rl-row9');
				const services = document.getElementById('rl-services');
				if (services && video14Wrap && row9) {
					const row9Rect = row9.getBoundingClientRect();
					const video14Rect = video14Wrap.getBoundingClientRect();
					const servicesWidth = services.getBoundingClientRect().width;
					services.style.left = (video14Rect.left - 8 - servicesWidth - row9Rect.left) + 'px';
					services.style.top = (video14Rect.top - row9Rect.top) + 'px';
				}
				if (img7 && row7 && video14Wrap) {
					const img7Width = img7.getBoundingClientRect().width;
					const currentML = parseFloat(getComputedStyle(row7).marginLeft) || 0;
					const target = video14Wrap.getBoundingClientRect().left - 8 - img7Width;
					row7.style.marginLeft = (currentML + (target - row7.getBoundingClientRect().left)) + 'px';
				}
				const row11Wrap = document.getElementById('rl-row11-wrap');
				if (img7 && row7 && row11Wrap) {
					const img7Rect = img7.getBoundingClientRect();
					const row7Rect = row7.getBoundingClientRect();
					const row11Width = row11Wrap.getBoundingClientRect().width;
					row11Wrap.style.left = (img7Rect.left - row11Width - row7Rect.left) + 'px';
					row11Wrap.style.top = (img7Rect.bottom + 8 - row7Rect.top) + 'px';
				}
				const img13bis = document.getElementById('rl-img13bis');
				const deliverables = document.getElementById('rl-deliverables');
				if (img13bis && row11Wrap && row7 && deliverables) {
					const img13bisRect = img13bis.getBoundingClientRect();
					const row11WrapRect = row11Wrap.getBoundingClientRect();
					const row7Rect = row7.getBoundingClientRect();
					const deliverablesWidth = deliverables.getBoundingClientRect().width;
					deliverables.style.left = (img13bisRect.right - deliverablesWidth - row7Rect.left) + 'px';
					deliverables.style.top = (row11WrapRect.bottom + 8 - row7Rect.top) + 'px';
				}
				const textCol = document.getElementById('rl-text-col');
				if (img7 && row7 && textCol) {
					const img7Rect = img7.getBoundingClientRect();
					const row7Rect = row7.getBoundingClientRect();
					const textColRect = textCol.getBoundingClientRect();
					textCol.style.left = (img7Rect.left - 16 - textColRect.width - row7Rect.left) + 'px';
					textCol.style.top = (img7Rect.top - row7Rect.top) + 'px';
				}
				const img8bis = document.getElementById('rl-img8bis');
				if (img7 && row7 && img8bis) {
					const img7Rect = img7.getBoundingClientRect();
					const row7Rect = row7.getBoundingClientRect();
					const img8bisHeight = img8bis.getBoundingClientRect().height;
					img8bis.style.left = (img7Rect.right + 8 - row7Rect.left) + 'px';
					img8bis.style.top = (img7Rect.bottom - img8bisHeight - row7Rect.top) + 'px';
				}
				const img16Wrap = document.getElementById('rl-img16-wrap');
				if (video14Wrap && img16Wrap) {
					const currentML = parseFloat(getComputedStyle(img16Wrap).marginLeft) || 0;
					const img16Width = img16Wrap.getBoundingClientRect().width;
					img16Wrap.style.marginLeft = (currentML + (video14Wrap.getBoundingClientRect().left - img16Width - img16Wrap.getBoundingClientRect().left)) + 'px';
					const currentMT = parseFloat(getComputedStyle(img16Wrap).marginTop) || 0;
					img16Wrap.style.marginTop = (currentMT + (video14Wrap.getBoundingClientRect().bottom - img16Wrap.getBoundingClientRect().top)) + 'px';
				}
				const img9bis = document.getElementById('rl-img9bis');
				const row14 = document.getElementById('rl-row14');
				const img17Visual = document.getElementById('rl-img17-visual');
				const img6bis = document.getElementById('rl-img6bis');
				if (img16Wrap && img17Visual) {
					const currentML = parseFloat(getComputedStyle(img17Visual).marginLeft) || 0;
					const delta = img16Wrap.getBoundingClientRect().left - img17Visual.getBoundingClientRect().left;
					img17Visual.style.marginLeft = (currentML + delta) + 'px';
				}
				if (img9bis && row14 && img17Visual) {
					const img17Rect = img17Visual.getBoundingClientRect();
					const row14Rect = row14.getBoundingClientRect();
					const img9bisWidth = img9bis.getBoundingClientRect().width;
					img9bis.style.left = (img17Rect.left - 8 - img9bisWidth - row14Rect.left) + 'px';
					img9bis.style.top = (img17Rect.top - row14Rect.top) + 'px';
				}
				const img2 = document.getElementById('rl-img2');
				if (img2 && img9bis && row14) {
					const img9bisRect = img9bis.getBoundingClientRect();
					const row14Rect = row14.getBoundingClientRect();
					const img2Rect = img2.getBoundingClientRect();
					img2.style.left = (img9bisRect.left - 8 - img2Rect.width - row14Rect.left) + 'px';
					img2.style.top = (img9bisRect.bottom - img2Rect.height - row14Rect.top) + 'px';
				}
				const img3 = document.getElementById('rl-img3');
				const video1 = document.getElementById('rl-video');
				const video1Wrap = video1 ? video1.parentElement : null;
				const rowVideo = document.getElementById('rl-row-video');
				if (video1Wrap && img2) {
					const currentML = parseFloat(getComputedStyle(video1Wrap).marginLeft) || 0;
					const video1Width = video1Wrap.getBoundingClientRect().width;
					video1Wrap.style.marginLeft = (currentML + (img2.getBoundingClientRect().right - video1Width - video1Wrap.getBoundingClientRect().left)) + 'px';
				}
				if (img3 && video1Wrap && row14) {
					const row14Rect = row14.getBoundingClientRect();
					img3.style.left = (video1Wrap.getBoundingClientRect().right + 8 - row14Rect.left) + 'px';
				}
				if (img3 && row14 && video1Wrap) {
					const row14Rect = row14.getBoundingClientRect();
					const video1Rect = video1Wrap.getBoundingClientRect();
					img3.style.top = (video1Rect.top - row14Rect.top) + 'px';
				}
				if (img9bis && rowVideo) {
					const currentMT = parseFloat(getComputedStyle(rowVideo).marginTop) || 0;
					rowVideo.style.marginTop = (currentMT + (img9bis.getBoundingClientRect().bottom + 58 - rowVideo.getBoundingClientRect().top)) + 'px';
				}
			};
			layoutRows();
			window.addEventListener('resize', layoutRows);
			window.addEventListener('load', layoutRows);
		</script>
	</body>
</html>
