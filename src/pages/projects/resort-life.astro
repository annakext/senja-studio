---
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '../../styles/global.css';
import Footer from '../../components/Footer.astro';
import VideoHoverSound from '../../components/VideoHoverSound.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>resort life — SENJA STUDIO</title>
		<style>
			:global(html), :global(body) { overflow: auto; height: auto; min-height: 100%; background: #fff; }
			:global(body) { position: relative; }
			.nav-link { position: relative; text-decoration: none; }
			.nav-link.fixed { position: fixed; }
			.nav-link::after { content: ""; position: absolute; left: 0; bottom: 1px; width: 0; height: 1px; background: currentColor; transition: width 0.3s ease; }
			.nav-link:hover::after { width: 100%; }
			.nav-link.active::after { width: 100%; }
		</style>
	</head>
	<body>
		<div style="position: absolute; inset: 0; z-index: -1; background: #fff;"></div>
		<main class="min-h-screen px-6 pb-24 pt-48 reveal-page">
			<div id="rl-row7" class="ml-[304px] flex w-fit flex-row items-end gap-2">
				<img id="rl-img7" src="/images/resort-life/7.webp" alt="" class="w-[320px] aspect-[4/5] object-cover" loading="lazy" />
				<div class="flex h-[400px] flex-col justify-between">
					<p id="rl-text" class="max-w-[220px] text-[0.76rem] font-[325] text-justify" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.5;">A resort is experienced as a sequence of spaces rather than a collection of rooms. Pools, lobbies, restaurants and quiet corners shape the rhythm of a stay as much as the accommodation itself. Through careful attention to light, texture and materials, these images explore the character of a place and the quiet experience it offers.</p>
					<img id="rl-img8bis" src="/images/resort-life/8bis.webp" alt="" class="w-[110px] h-[157px] object-cover object-bottom" loading="lazy" />
				</div>
			</div>

			<div id="rl-row9" class="mt-2 ml-[559px] flex w-fit flex-row items-end gap-2">
				<img id="rl-img16" src="/images/resort-life/16.webp" alt="" class="w-[167px] aspect-[2160/2544] object-cover" loading="lazy" />
				<VideoHoverSound>
					<video id="rl-video14" src="/videos/resort-life-14.mp4" class="w-[230px] aspect-[9/16] object-cover" autoplay loop muted playsinline></video>
				</VideoHoverSound>
			</div>

			<div id="rl-row11" class="mt-2 ml-[169px] flex w-fit flex-row gap-2">
				<img src="/images/resort-life/11qua.webp" alt="" class="w-[183px] aspect-[9/16] object-cover brightness-105" loading="lazy" />
				<img src="/images/resort-life/12ter.webp" alt="" class="w-[183px] aspect-[9/16] object-cover brightness-105" loading="lazy" />
				<img id="rl-img13bis" src="/images/resort-life/13bis.webp" alt="" class="w-[183px] aspect-[9/16] object-cover brightness-105" loading="lazy" />
			</div>

			<div id="rl-row14" class="mt-2 ml-[566px] flex w-fit flex-row items-end gap-2">
				<img id="rl-img17" src="/images/resort-life/17.webp" alt="" class="w-[160px] aspect-[2160/2544] object-cover object-[center_65%] brightness-110" loading="lazy" />
				<img id="rl-img9bis" src="/images/resort-life/9bis.webp" alt="" class="w-[320px] aspect-[3/4] object-cover" loading="lazy" />
			</div>

			<div class="mt-2 ml-[67px] flex w-fit flex-row items-end gap-6">
				<VideoHoverSound>
					<video id="rl-video" src="/videos/resort-life-1.mp4" class="w-[499px] h-[355px] rounded-[12px] object-cover brightness-115" autoplay loop muted playsinline></video>
				</VideoHoverSound>
			</div>

			<img id="rl-img2" src="/images/resort-life/2.webp" alt="" class="mt-2 ml-[124px] w-[420px] aspect-[16/9] object-cover" />

			<div id="rl-row3" class="mt-2 ml-[544px] flex w-fit flex-row gap-2">
				<img src="/images/resort-life/3.webp" alt="" class="w-[120px] aspect-[3/4] object-cover" loading="lazy" />
				<img src="/images/resort-life/4.webp" alt="" class="w-[120px] aspect-[3/4] object-cover" loading="lazy" />
				<img src="/images/resort-life/5.webp" alt="" class="w-[120px] aspect-[3/4] object-cover" loading="lazy" />
				<img src="/images/resort-life/6bis.webp" alt="" class="w-[120px] aspect-[3/4] object-cover" loading="lazy" />
			</div>

			<a href="/projects/curated-places" class="mt-16 block pt-6" style="border-top: 0.5px solid #1c1c1c;">
				<p class="text-[0.76rem] font-[325] uppercase" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.08em; color: #8c8a84;">Next</p>
				<p class="mt-1 text-[0.76rem] font-[325] tabular-nums" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.15;">3/4<br />CURATED PLACES<br />lifestyle, food and culture</p>
			</a>
		</main>

		<div class="js-blend-fixed absolute top-3 left-6 right-6 flex flex-row items-start">
			<a href="/" class="block text-[41px] leading-tight font-normal" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.05em; color: #fff; mix-blend-mode: difference; text-transform: uppercase;">senja studio</a>
		</div>
		<div class="absolute top-3 left-1/2 z-10 w-1/2 pointer-events-none">
			<p class="text-[0.76rem] font-[325]" style="margin-top: 7px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.15;">2/4<br />RESORT LIFE<br />stillness and light</p>
		</div>
		<nav class="js-blend-fixed absolute right-6 flex flex-row text-[0.76rem] font-[325]" style="top: 17px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c;">
			<a href="/" class="nav-link active">projects</a><span>,&nbsp;</span><a href="/services" class="nav-link">services</a><span>,&nbsp;</span><a href="/about" class="nav-link">about</a><span>,&nbsp;</span><a href="/contact" class="nav-link">contact</a>
		</nav>
		<a href="https://www.instagram.com/roll.bysenja/" target="_blank" rel="noopener noreferrer" class="fixed z-10" style="top: 44px; right: 23.5px;" aria-label="Instagram">
			<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
				<rect x="2" y="2" width="20" height="20" rx="5" stroke="#1c1c1c" stroke-width="2" />
				<circle cx="12" cy="12" r="5" stroke="#1c1c1c" stroke-width="2" />
				<circle cx="18" cy="6" r="1.3" fill="#1c1c1c" />
			</svg>
		</a>

		<a href="/" class="fixed left-6 z-10 text-2xl font-normal" style="top: 84px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1c1c1c; text-decoration: none;">←</a>

		<Footer fixed={false} />
		<script>
			import { initHoverSoundVideos } from '../../scripts/video-hover-sound.js';
			initHoverSoundVideos();

			const blendFixedEls = Array.from(document.querySelectorAll('.js-blend-fixed')).map((el) => ({
				el,
				offset: parseFloat(getComputedStyle(el).top) || 0,
			}));
			const syncBlendFixed = () => {
				blendFixedEls.forEach(({ el, offset }) => {
					el.style.top = (window.scrollY + offset) + 'px';
				});
			};
			syncBlendFixed();
			window.addEventListener('scroll', syncBlendFixed, { passive: true });
			window.addEventListener('resize', syncBlendFixed);

		</script>
	</body>
</html>
