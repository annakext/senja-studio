---
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '../../styles/global.css';
import Footer from '../../components/Footer.astro';
import VideoHoverSound from '../../components/VideoHoverSound.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>curated places — SENJA STUDIO</title>
		<meta name="description" content="Curated Places — lifestyle, food and culture, visual content by Senja Studio for hospitality and lifestyle brands." />
		<style>
			:global(html), :global(body) { overflow: auto; height: auto; min-height: 100%; background: #fff; }
			:global(body) { position: relative; }
			.nav-link { position: relative; text-decoration: none; }
			.nav-link.fixed { position: fixed; }
			.nav-link::after { content: ""; position: absolute; left: 0; bottom: 1px; width: 0; height: 1px; background: currentColor; transition: width 0.3s ease; }
			.nav-link:hover::after { width: 100%; }
			.nav-link.active::after { width: 100%; }
		</style>
	</head>
	<body>
		<div style="position: absolute; inset: 0; z-index: -1; background: #fff;"></div>
		<main class="min-h-screen px-6 pb-24 pt-48 reveal-page">
			<div id="cp-row1" class="relative flex w-fit flex-row items-start gap-4">
				<div id="cp-img1qua" class="absolute w-[115px] h-[150px]">
					<img src="/images/curated-places/1qua.webp" alt="" class="h-full w-full object-cover" />
					<div class="pointer-events-none absolute inset-0 bg-white/[0.03]"></div>
				</div>
				<p id="cp-text" class="max-w-[220px] text-[0.76rem] font-[325] text-justify" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.5;">Curated places are defined by the details that shape their identity. Concept stores, restaurants, spas and the spaces in between. Through a mix of digital formats and vintage-inspired imagery, these visuals offer a more personal perspective on each place, capturing atmosphere over artifice.</p>
				<div id="cp-triptych" class="flex flex-row items-start gap-2">
					<img src="/images/curated-places/5.webp" alt="" class="w-[145px] aspect-[9/16] object-cover" />
					<img src="/images/curated-places/4.webp" alt="" class="w-[145px] aspect-[9/16] object-cover" />
					<img id="cp-img3" src="/images/curated-places/3.webp" alt="" class="w-[145px] aspect-[9/16] object-cover" />
				</div>
			</div>

			<p id="cp-deliverables" class="mt-2 ml-auto w-fit whitespace-nowrap text-[0.76rem] font-[325]" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.5;"><span class="mr-4 italic lowercase">deliverables</span>instagram feed · reels · stories · website imagery · paid ads · lookbook · editorial</p>

			<div id="cp-img2ter" class="relative w-[115px] h-[150px]">
				<img src="/images/curated-places/2ter.webp" alt="" class="h-full w-full object-cover object-bottom" />
				<div class="pointer-events-none absolute inset-0 bg-white/[0.03]"></div>
			</div>

			<VideoHoverSound class="mt-2">
				<video id="cp-video6" src="/videos/curated-places-6.mp4" class="w-[170px] aspect-[9/16] object-cover" autoplay loop muted playsinline></video>
			</VideoHoverSound>

			<div id="cp-row7" class="relative mt-2 flex w-fit flex-row items-end gap-2">
				<img id="cp-img7" src="/images/curated-places/7.webp" alt="" class="w-[160px] aspect-[3/4] object-cover" loading="lazy" />
				<img id="cp-img8bis" src="/images/curated-places/8bis.webp" alt="" class="w-[210px] aspect-[4/3] object-cover" loading="lazy" />
				<p id="cp-services" class="absolute text-left text-[0.76rem] font-[325]" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.5;"><span class="italic lowercase">services</span><br /><br />concept<br />creative direction<br />photography<br />film<br />ugc<br />post-production<br />brand consulting<br />content strategy</p>
			</div>

			<div id="cp-video9" class="relative mt-2 ml-auto w-[400px] aspect-[16/9]">
				<video src="/videos/curated-places-9.mp4" class="h-full w-full rounded-[10px] object-cover" autoplay loop muted playsinline></video>
				<div class="pointer-events-none absolute inset-0 rounded-[10px] bg-white/[0.08]"></div>
			</div>

			<a href="/projects/ugc" class="mt-16 block pt-6" style="border-top: 0.5px solid #1c1c1c;">
				<p class="text-[0.76rem] font-[325] uppercase" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.08em; color: #8c8a84;">Next</p>
				<p class="mt-1 text-[calc(0.76rem+2pt)] font-[325] tabular-nums" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.15;">4/4<br />UGC<br />authentic and ready to post</p>
			</a>
		</main>

		<div class="js-blend-fixed absolute top-3 left-6 right-6 flex flex-row items-start">
			<a href="/" class="block text-[41px] leading-tight font-normal" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.05em; color: #fff; mix-blend-mode: difference; text-transform: uppercase;">senja studio</a>
		</div>
		<div class="absolute top-3 left-1/2 z-10 w-1/2 pointer-events-none">
			<p id="cp-header-info" class="text-[0.76rem] font-[325]" style="margin-top: 7px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.15;">3/4<br />CURATED PLACES<br />lifestyle, food and culture</p>
		</div>
		<nav class="js-blend-fixed absolute right-6 flex flex-row text-[0.76rem] font-[325]" style="top: 17px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #fff; mix-blend-mode: difference;">
			<a href="/" class="nav-link active">projects</a><span>,&nbsp;</span><a href="/services" class="nav-link">services</a><span>,&nbsp;</span><a href="/about" class="nav-link">about</a><span>,&nbsp;</span><a href="/contact" class="nav-link">contact</a>
		</nav>
		<a href="/" class="fixed left-6 z-10 text-2xl font-normal" style="top: 84px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1c1c1c; text-decoration: none;">←</a>

		<Footer fixed={false} />
		<script>
			import { initHoverSoundVideos } from '../../scripts/video-hover-sound.js';
			initHoverSoundVideos();

			const blendFixedEls = Array.from(document.querySelectorAll('.js-blend-fixed')).map((el) => ({
				el,
				offset: parseFloat(getComputedStyle(el).top) || 0,
			}));
			const syncBlendFixed = () => {
				blendFixedEls.forEach(({ el, offset }) => {
					el.style.top = (window.scrollY + offset) + 'px';
				});
			};
			syncBlendFixed();
			window.addEventListener('scroll', syncBlendFixed, { passive: true });
			window.addEventListener('resize', syncBlendFixed);

			const alignLeftEdgeTo = (el, targetX) => {
				const currentML = parseFloat(getComputedStyle(el).marginLeft) || 0;
				el.style.marginLeft = (currentML + (targetX - el.getBoundingClientRect().left)) + 'px';
			};
			const alignRightEdgeTo = (el, targetX) => {
				const currentMR = parseFloat(getComputedStyle(el).marginRight) || 0;
				el.style.marginRight = (currentMR + (el.getBoundingClientRect().right - targetX)) + 'px';
			};
			const layoutRows = () => {
				const text = document.getElementById('cp-text');
				const headerInfo = document.getElementById('cp-header-info');
				const triptych = document.getElementById('cp-triptych');
				const row1 = document.getElementById('cp-row1');
				if (headerInfo && triptych && row1) {
					const offset = triptych.getBoundingClientRect().left - row1.getBoundingClientRect().left;
					alignLeftEdgeTo(row1, headerInfo.getBoundingClientRect().left - offset);
				}
				if (text && triptych) {
					const targetHeight = text.getBoundingClientRect().height + 170;
					const targetWidth = targetHeight * (9 / 16);
					triptych.querySelectorAll('img').forEach((img) => {
						img.style.width = targetWidth + 'px';
					});
				}
				if (text && triptych) {
					const currentMT = parseFloat(getComputedStyle(text).marginTop) || 0;
					text.style.marginTop = (currentMT + (triptych.getBoundingClientRect().bottom - 15 - text.getBoundingClientRect().bottom)) + 'px';
				}
				const img1qua = document.getElementById('cp-img1qua');
				if (triptych && row1 && img1qua) {
					const triptychRect = triptych.getBoundingClientRect();
					const row1Rect = row1.getBoundingClientRect();
					img1qua.style.left = (triptychRect.right - row1Rect.left) + 'px';
					img1qua.style.top = (triptychRect.bottom - row1Rect.top) + 'px';
				}
				const nav = document.querySelector('nav');
				if (nav && row1 && img1qua) {
					const currentML = parseFloat(getComputedStyle(row1).marginLeft) || 0;
					row1.style.marginLeft = (currentML + (nav.getBoundingClientRect().right - img1qua.getBoundingClientRect().right)) + 'px';
				}
				const img3 = document.getElementById('cp-img3');
				const deliverables = document.getElementById('cp-deliverables');
				if (img3 && deliverables) alignRightEdgeTo(deliverables, img3.getBoundingClientRect().right - 8);
				const video6 = document.getElementById('cp-video6');
				if (text && video6) {
					video6.style.width = (text.getBoundingClientRect().width + 32) + 'px';
				}
				const video6Wrap = video6 ? video6.parentElement : null;
				const img5 = triptych ? triptych.querySelector('img') : null;
				if (img5 && video6Wrap) {
					const img5Rect = img5.getBoundingClientRect();
					const video6Width = video6Wrap.getBoundingClientRect().width;
					const currentML = parseFloat(getComputedStyle(video6Wrap).marginLeft) || 0;
					video6Wrap.style.marginLeft = (currentML + (img5Rect.left - video6Width - video6Wrap.getBoundingClientRect().left)) + 'px';
					const currentMT = parseFloat(getComputedStyle(video6Wrap).marginTop) || 0;
					video6Wrap.style.marginTop = (currentMT + (img5Rect.bottom - video6Wrap.getBoundingClientRect().top)) + 'px';
				}
				const img2ter = document.getElementById('cp-img2ter');
				if (video6Wrap && img2ter) {
					const currentMT = parseFloat(getComputedStyle(img2ter).marginTop) || 0;
					img2ter.style.marginTop = (currentMT + (video6Wrap.getBoundingClientRect().top - img2ter.getBoundingClientRect().top)) + 'px';
					const currentML = parseFloat(getComputedStyle(img2ter).marginLeft) || 0;
					const img2terWidth = img2ter.getBoundingClientRect().width;
					img2ter.style.marginLeft = (currentML + (video6Wrap.getBoundingClientRect().left - 8 - img2terWidth - img2ter.getBoundingClientRect().left)) + 'px';
				}
				const img7 = document.getElementById('cp-img7');
				if (video6 && img7) {
					img7.style.width = (video6.getBoundingClientRect().width + 30) + 'px';
					alignLeftEdgeTo(img7, video6.getBoundingClientRect().right);
				}
				const video9 = document.getElementById('cp-video9');
				if (img7 && video9) alignRightEdgeTo(video9, img7.getBoundingClientRect().right);
				const row7 = document.getElementById('cp-row7');
				const services = document.getElementById('cp-services');
				if (services && img7 && row7) {
					const img7Rect = img7.getBoundingClientRect();
					const row7Rect = row7.getBoundingClientRect();
					services.style.left = (img7Rect.right + 8 - row7Rect.left) + 'px';
					services.style.top = (img7Rect.top - row7Rect.top) + 'px';
				}
			};
			layoutRows();
			window.addEventListener('resize', layoutRows);
			window.addEventListener('load', layoutRows);
		</script>
	</body>
</html>
