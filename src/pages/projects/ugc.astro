---
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '../../styles/global.css';
import Footer from '../../components/Footer.astro';
import VideoHoverSound from '../../components/VideoHoverSound.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>ugc — SENJA STUDIO</title>
		<meta name="description" content="UGC — authentic and ready to post content, created by Senja Studio for hospitality and lifestyle brands." />
		<style>
			:global(html), :global(body) { overflow: auto; height: auto; min-height: 100%; background: #fff; }
			:global(body) { position: relative; }
			.nav-link { position: relative; text-decoration: none; }
			.nav-link.fixed { position: fixed; }
			.nav-link::after { content: ""; position: absolute; left: 0; bottom: 1px; width: 0; height: 1px; background: currentColor; transition: width 0.3s ease; }
			.nav-link:hover::after { width: 100%; }
			.nav-link.active::after { width: 100%; }
		</style>
	</head>
	<body>
		<div style="position: absolute; inset: 0; z-index: -1; background: #fff;"></div>
		<main class="min-h-screen px-6 pb-24 pt-48 reveal-page">
			<div id="ugc-row-lanterns" class="ml-auto flex w-fit flex-row items-end gap-2">
				<div id="ugc-lanterns-wrap" class="relative w-[347px] h-[190px]">
					<img src="/images/ugc/3bis.webp" alt="" class="h-full w-full object-cover" />
					<div class="pointer-events-none absolute inset-0 bg-white/[0.1]"></div>
				</div>
			</div>

			<div id="ugc-row1" class="relative mt-[-227px] flex w-fit flex-row items-end gap-4">
				<div id="ugc-images1" class="flex flex-row items-end gap-2">
					<div class="relative w-[160px] aspect-[694/933]">
						<img id="ugc-img1" src="/images/ugc/1.webp" alt="" class="h-full w-full object-cover" />
						<div class="pointer-events-none absolute inset-0 bg-white/[0.05]"></div>
					</div>
					<VideoHoverSound>
						<video id="ugc-video2" src="/videos/ugc-2.mp4" class="w-[230px] aspect-[9/16] object-cover brightness-125 saturate-90 contrast-95" autoplay loop muted playsinline></video>
						<div class="pointer-events-none absolute inset-0 bg-white/[0.05]"></div>
					</VideoHoverSound>
				</div>
				<p class="self-end max-w-[220px] text-[0.76rem] font-[325] text-justify" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.5;">Designed for social platforms, these visuals combine a natural perspective with a refined aesthetic. Created to feel spontaneous yet intentional, the content captures the experience and atmosphere of a place while remaining ready to share across digital channels. Shot from a genuine guest perspective, it is the kind of content that audiences instinctively trust.</p>
				<p id="ugc-services" class="absolute text-right text-[0.76rem] font-[325]" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.5;"><span class="italic lowercase">services</span><br /><br />ugc<br />post-production<br />content strategy</p>
			</div>

			<p id="ugc-deliverables" class="mt-[95.5px] ml-auto w-fit whitespace-nowrap text-[0.76rem] font-[325]" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.5;"><span class="mr-4 italic lowercase">deliverables</span>reels · stories · paid ads</p>

			<div id="ugc-row6" class="mt-2 ml-auto flex w-fit flex-row items-end gap-2">
				<VideoHoverSound>
					<video id="ugc-video6" src="/videos/ugc-6.mp4" class="w-[215px] aspect-[9/16] object-cover" autoplay loop muted playsinline></video>
				</VideoHoverSound>
				<img id="ugc-img7" src="/images/ugc/7.webp" alt="" class="w-[420px] aspect-[4032/3024] object-cover" loading="lazy" />
				<VideoHoverSound>
					<video id="ugc-video11" src="/videos/ugc-11.mp4" class="w-[215px] aspect-[9/16] object-cover" autoplay loop muted playsinline></video>
				</VideoHoverSound>
			</div>

			<div id="ugc-row12" class="flex w-fit flex-row items-start gap-2">
				<div id="ugc-1415-block" class="flex flex-row items-end gap-2">
					<img id="ugc-img14" src="/images/ugc/14.webp" alt="" class="w-[215px] aspect-[3024/4032] object-cover" loading="lazy" />
					<img id="ugc-img15" src="/images/ugc/15.webp" alt="" class="w-[215px] aspect-[3024/4032] object-cover" loading="lazy" />
				</div>
				<VideoHoverSound>
					<video id="ugc-video12" src="/videos/ugc-12.mp4" class="w-[242px] h-[384px] object-cover object-[center_60%] brightness-115 contrast-75" autoplay loop muted playsinline></video>
				</VideoHoverSound>
				<div class="relative w-[215px] aspect-[1000/631]">
					<img id="ugc-img5" src="/images/ugc/5.webp" alt="" class="h-full w-full object-left object-cover" loading="lazy" />
					<div class="pointer-events-none absolute inset-0 bg-white/[0.08]"></div>
				</div>
			</div>

			<a href="/projects/villa-connexion" class="mt-16 block pt-6" style="border-top: 0.5px solid #1c1c1c;">
				<p class="text-[0.76rem] font-[325] uppercase" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.08em; color: #8c8a84;">Next</p>
				<p class="mt-1 text-[calc(0.76rem+2pt)] font-[325] tabular-nums" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.15;">1/4<br />VILLA CONNEXION<br />intimate luxurious spaces</p>
			</a>
		</main>

		<div class="js-blend-fixed absolute top-3 left-6 right-6 flex flex-row items-start">
			<a id="site-logo" href="/" class="block text-[41px] leading-tight font-normal" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.05em; color: #fff; mix-blend-mode: difference; text-transform: uppercase;">senja studio</a>
		</div>
		<div class="absolute top-3 left-1/2 z-10 w-1/2 pointer-events-none">
			<p class="text-[0.76rem] font-[325]" style="margin-top: 7px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.15;">4/4<br />UGC<br />authentic and ready to post</p>
		</div>
		<nav id="ugc-nav" class="js-blend-fixed absolute right-6 flex flex-row text-[0.76rem] font-[325]" style="top: 17px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #fff; mix-blend-mode: difference;">
			<a href="/" class="nav-link active">projects</a><span>,&nbsp;</span><a href="/services" class="nav-link">services</a><span>,&nbsp;</span><a href="/about" class="nav-link">about</a><span>,&nbsp;</span><a href="/contact" class="nav-link">contact</a>
		</nav>
		<a href="/" class="fixed left-6 z-10 text-2xl font-normal" style="top: 84px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1c1c1c; text-decoration: none;">←</a>

		<Footer fixed={false} />
		<script>
			import { initHoverSoundVideos } from '../../scripts/video-hover-sound.js';
			import { initResponsiveLogo } from '../../scripts/responsive-logo.js';
			initHoverSoundVideos();
			initResponsiveLogo();

			const blendFixedEls = Array.from(document.querySelectorAll('.js-blend-fixed')).map((el) => ({
				el,
				offset: parseFloat(getComputedStyle(el).top) || 0,
			}));
			const syncBlendFixed = () => {
				blendFixedEls.forEach(({ el, offset }) => {
					el.style.top = (window.scrollY + offset) + 'px';
				});
			};
			syncBlendFixed();
			window.addEventListener('scroll', syncBlendFixed, { passive: true });
			window.addEventListener('resize', syncBlendFixed);

			const alignRightEdgeTo = (el, targetX) => {
				const currentMR = parseFloat(getComputedStyle(el).marginRight) || 0;
				el.style.marginRight = (currentMR + (el.getBoundingClientRect().right - targetX)) + 'px';
			};
			const alignLeftEdgeTo = (el, targetX) => {
				const currentML = parseFloat(getComputedStyle(el).marginLeft) || 0;
				el.style.marginLeft = (currentML + (targetX - el.getBoundingClientRect().left)) + 'px';
			};
			const alignTopEdgeTo = (el, targetY) => {
				const currentMT = parseFloat(getComputedStyle(el).marginTop) || 0;
				el.style.marginTop = (currentMT + (targetY - el.getBoundingClientRect().top)) + 'px';
			};
			const layoutRows = () => {
				const nav = document.getElementById('ugc-nav');
				const images1 = document.getElementById('ugc-images1');
				const video6 = document.getElementById('ugc-video6');
				const img7 = document.getElementById('ugc-img7');
				if (video6 && img7) {
					const targetHeight = video6.getBoundingClientRect().height;
					img7.style.width = (targetHeight * (4032 / 3024)) + 'px';
				}
				const row6 = document.getElementById('ugc-row6');
				if (nav && row6) alignRightEdgeTo(row6, nav.getBoundingClientRect().right);
				const deliverables = document.getElementById('ugc-deliverables');
				if (img7 && deliverables) alignRightEdgeTo(deliverables, img7.getBoundingClientRect().right);
				const video11 = document.getElementById('ugc-video11');
				const rowLanterns = document.getElementById('ugc-row-lanterns');
				if (video11 && rowLanterns) alignRightEdgeTo(rowLanterns, video11.getBoundingClientRect().right);
				const lanternsWrap = document.getElementById('ugc-lanterns-wrap');
				const text1 = document.querySelector('#ugc-row1 p');
				const video2 = document.getElementById('ugc-video2');
				if (lanternsWrap && video2) {
					const lanternsTop = lanternsWrap.getBoundingClientRect().top;
					const currentHeight = lanternsWrap.getBoundingClientRect().height;
					const video2Top = video2.getBoundingClientRect().top;
					const newHeight = currentHeight + (lanternsTop - video2Top);
					const newWidth = newHeight * (530 / 290);
					lanternsWrap.style.width = newWidth + 'px';
					lanternsWrap.style.height = newHeight + 'px';
				}
				const row1 = document.getElementById('ugc-row1');
				if (row1 && text1 && video2 && lanternsWrap) {
					const gapVideoText = text1.getBoundingClientRect().left - video2.getBoundingClientRect().right;
					const targetTextRight = lanternsWrap.getBoundingClientRect().left - gapVideoText;
					const currentML = parseFloat(getComputedStyle(row1).marginLeft) || 0;
					row1.style.marginLeft = (currentML + (targetTextRight - text1.getBoundingClientRect().right)) + 'px';
				}
				const img1 = document.getElementById('ugc-img1');
				const services = document.getElementById('ugc-services');
				if (services && img1 && row1) {
					const img1Rect = img1.getBoundingClientRect();
					const row1Rect = row1.getBoundingClientRect();
					const servicesWidth = services.getBoundingClientRect().width;
					services.style.left = (img1Rect.left - servicesWidth - row1Rect.left) + 'px';
					services.style.top = (img1Rect.bottom + 8 - row1Rect.top) + 'px';
				}
				const row12 = document.getElementById('ugc-row12');
				if (row6 && row12 && row1) {
					const gap23 = row6.getBoundingClientRect().top - row1.getBoundingClientRect().bottom;
					alignTopEdgeTo(row12, row6.getBoundingClientRect().bottom + gap23);
				}
				const block1415 = document.getElementById('ugc-1415-block');
				if (video6 && block1415) {
					const targetLeft = video6.getBoundingClientRect().right - block1415.getBoundingClientRect().width;
					alignLeftEdgeTo(block1415, targetLeft);
				}
				const video12 = document.getElementById('ugc-video12')?.parentElement;
				if (img7 && video12) {
					const targetLeft = img7.getBoundingClientRect().right - video12.getBoundingClientRect().width;
					alignLeftEdgeTo(video12, targetLeft);
				}
			};
			layoutRows();
			window.addEventListener('resize', layoutRows);
			window.addEventListener('load', layoutRows);
		</script>
	</body>
</html>
