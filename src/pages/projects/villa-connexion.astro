---
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '../../styles/global.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>villa connexion — senja studio</title>
		<style>
			:global(html), :global(body) { overflow: auto; height: auto; min-height: 100%; }
			.nav-link { position: relative; text-decoration: none; }
			.nav-link.fixed { position: fixed; }
			.nav-link::after { content: ""; position: absolute; left: 0; bottom: 1px; width: 0; height: 1px; background: currentColor; transition: width 0.3s ease; }
			.nav-link:hover::after { width: 100%; }
			.nav-link.active { color: #1c1c1c; }
			.nav-link.active::after { width: 100%; }
		</style>
	</head>
	<body>
		<div class="fixed top-3 left-6 right-6 z-10 flex flex-row items-start">
			<a href="/" class="block text-[41px] leading-tight font-normal" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.05em; color: #1c1c1c; text-transform: uppercase;">senja studio</a>
			<div class="ml-auto flex w-1/2 flex-col items-start">
				<p class="text-[0.76rem] font-[325]" style="margin-top: 7px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.15;">1/4<br />VILLA CONNEXION<br />intimate luxurious spaces</p>
			</div>
		</div>
		<nav class="fixed right-6 z-10 flex flex-row text-[0.76rem] font-[325]" style="top: 17px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c;">
			<a href="/" class="nav-link active">projects</a><span>,&nbsp;</span><a href="/services" class="nav-link">services</a><span>,&nbsp;</span><a href="/about" class="nav-link">about</a><span>,&nbsp;</span><a href="/contact" class="nav-link">contact</a>
		</nav>

		<a href="/" class="nav-link fixed left-6 z-10 text-[0.76rem] font-[325]" style="top: 84px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c;">← projects</a>

		<main class="min-h-screen px-6 pb-24 pt-32">
			<div class="mx-auto max-w-3xl">
				<img src="/images/projects-photo-5.jpg?v=2" alt="Villa Connexion" class="aspect-[4/5] w-full max-w-xl object-cover" />

				<a href="/projects/resort-life" class="mt-16 block max-w-xl pt-6" style="border-top: 0.5px solid #1c1c1c;">
					<p class="text-[0.7rem] font-[325] uppercase" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.08em; color: #8c8a84;">Next</p>
					<p class="mt-1 text-[0.76rem] font-[325] tabular-nums" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c;">2/4</p>
					<p class="mt-1 text-base font-normal" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c;">RESORT LIFE</p>
				</a>
			</div>
		</main>
	</body>
</html>
