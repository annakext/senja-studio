---
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '../../styles/global.css';
import Footer from '../../components/Footer.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>villa connexion — senja studio</title>
		<style>
			:global(html), :global(body) { overflow: auto; height: auto; min-height: 100%; }
			.nav-link { position: relative; text-decoration: none; }
			.nav-link.fixed { position: fixed; }
			.nav-link::after { content: ""; position: absolute; left: 0; bottom: 1px; width: 0; height: 1px; background: currentColor; transition: width 0.3s ease; }
			.nav-link:hover::after { width: 100%; }
			.nav-link.active { color: #1c1c1c; }
			.nav-link.active::after { width: 100%; }
		</style>
	</head>
	<body>
		<div class="fixed top-3 left-6 right-6 z-10 flex flex-row items-start">
			<a href="/" class="block text-[41px] leading-tight font-normal" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.05em; color: #1c1c1c; text-transform: uppercase;">senja studio</a>
			<div class="ml-auto flex w-1/2 flex-col items-start">
				<p class="text-[0.76rem] font-[325]" style="margin-top: 7px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.15;">1/4<br />VILLA CONNEXION<br />intimate luxurious spaces</p>
			</div>
		</div>
		<nav class="fixed right-6 z-10 flex flex-row text-[0.76rem] font-[325]" style="top: 17px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c;">
			<a href="/" class="nav-link active">projects</a><span>,&nbsp;</span><a href="/services" class="nav-link">services</a><span>,&nbsp;</span><a href="/about" class="nav-link">about</a><span>,&nbsp;</span><a href="/contact" class="nav-link">contact</a>
		</nav>

		<a href="/" class="fixed left-6 z-10 text-2xl font-normal" style="top: 84px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1c1c1c; text-decoration: none;">←</a>

		<main class="min-h-screen px-6 pb-24 pt-32">
			<div class="flex flex-row justify-end gap-2">
				<img src="/images/villa-connexion/01.jpg" alt="" class="w-1/3 max-w-[195px] aspect-[3/4] object-cover" />
				<img src="/images/villa-connexion/02.jpg" alt="" class="w-1/3 max-w-[195px] aspect-[3/4] object-cover" />
			</div>

			<div class="-mt-[160px] ml-auto mr-[414px] flex w-fit flex-row items-end">
				<img src="/images/villa-connexion/03.jpg" alt="" class="mr-2 w-[135px] aspect-[3/4] object-cover" />
				<video src="/videos/villa-connexion-ubud.mp4" class="mr-4 w-[203px] aspect-[9/16] object-cover" autoplay loop muted playsinline></video>
				<p class="max-w-[220px] text-[0.76rem] font-[325] text-justify" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.5;">Private villas reveal their character through the interplay of light, texture and architectural details. Their intimate scale creates a more personal experience, where privacy, comfort and everyday functionality become central to the space. The imagery favours atmosphere over polish, conveying a sense of presence and authenticity. It is an approach that values memory and feeling as much as visual clarity.</p>
			</div>

			<div class="mt-16 flex flex-row justify-end items-start gap-4">
				<img src="/images/villa-connexion/05.jpg" alt="" class="w-[180px] aspect-[3/4] object-cover" />
				<img src="/images/villa-connexion/06.jpg" alt="" class="w-[180px] aspect-[3/4] object-cover" />
				<img src="/images/villa-connexion/07.jpg" alt="" class="w-[180px] aspect-[3/4] object-cover" />
				<video src="/videos/villa-connexion-leaves.mp4" class="w-[180px] aspect-[9/16] object-cover" autoplay loop muted playsinline></video>
			</div>

			<a href="/projects/resort-life" class="mt-16 block pt-6" style="border-top: 0.5px solid #1c1c1c;">
				<p class="text-[0.76rem] font-[325] uppercase" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.08em; color: #8c8a84;">Next</p>
				<p class="mt-1 text-[0.76rem] font-[325] tabular-nums" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.15;">2/4<br />RESORT LIFE<br />stillness and light</p>
			</a>
		</main>

		<Footer />
	</body>
</html>
