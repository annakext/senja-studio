---
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '../../styles/global.css';
import Footer from '../../components/Footer.astro';
import VideoHoverSound from '../../components/VideoHoverSound.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>villa connexion — SENJA STUDIO</title>
		<meta name="description" content="Villa Connexion — intimate luxurious spaces, visual content by Senja Studio for hospitality and lifestyle brands." />
		<style>
			:global(html), :global(body) { overflow: auto; height: auto; min-height: 100%; background: #fff; }
			:global(body) { position: relative; }
			.nav-link { position: relative; text-decoration: none; }
			.nav-link.fixed { position: fixed; }
			.nav-link::after { content: ""; position: absolute; left: 0; bottom: 1px; width: 0; height: 1px; background: currentColor; transition: width 0.3s ease; }
			.nav-link:hover::after { width: 100%; }
			.nav-link.active::after { width: 100%; }
		</style>
	</head>
	<body>
		<div style="position: absolute; inset: 0; z-index: -1; background: #fff;"></div>
		<main class="min-h-screen px-6 pb-24 pt-48 reveal-page">
			<div class="flex flex-row justify-end gap-2">
				<img src="/images/villa-connexion/01.webp" alt="" class="w-1/3 max-w-[195px] aspect-[3/4] object-cover" />
				<img src="/images/villa-connexion/02.webp" alt="" class="w-1/3 max-w-[195px] aspect-[3/4] object-cover" />
			</div>

			<div id="vc-row2" class="-mt-[160px] ml-auto flex w-fit flex-row items-end">
				<img src="/images/villa-connexion/03.webp" alt="" class="mr-2 w-[135px] aspect-[3/4] object-cover" />
				<VideoHoverSound class="mr-4">
					<video src="/videos/villa-connexion-ubud.mp4" class="w-[203px] aspect-[9/16] object-cover" autoplay loop muted playsinline></video>
				</VideoHoverSound>
				<p class="max-w-[220px] text-[0.76rem] font-[325] text-justify" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.5;">Private villas reveal their character through the interplay of light, texture and architectural details. Their intimate scale creates a more personal experience, where privacy, comfort and everyday functionality become central to the space. The imagery favours atmosphere over polish, conveying a sense of presence and authenticity. It is an approach that values memory and feeling as much as visual clarity.</p>
			</div>

			<div class="mt-16 flex flex-row justify-end items-start gap-2">
				<p class="mr-2 text-[0.76rem] font-[325] text-right" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.5;"><span class="italic lowercase">services</span><br /><br />concept<br />creative direction<br />photography<br />film<br />ugc<br />post-production</p>
				<img src="/images/villa-connexion/05.webp" alt="" class="w-[180px] aspect-[3/4] object-cover" loading="lazy" />
				<img src="/images/villa-connexion/06.webp" alt="" class="w-[180px] aspect-[3/4] object-cover" loading="lazy" />
				<img src="/images/villa-connexion/07.webp" alt="" class="w-[180px] aspect-[3/4] object-cover" loading="lazy" />
				<video id="vc-video-leaves" src="/videos/villa-connexion-leaves.mp4" class="w-[180px] aspect-[3/4] object-cover object-bottom" autoplay loop muted playsinline></video>
			</div>

			<p id="vc-deliverables" class="mt-2 ml-auto w-fit text-[0.76rem] font-[325]" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.5;"><span class="mr-4 italic lowercase">deliverables</span>instagram feed · reels · stories · website imagery</p>

			<div id="vc-row4" class="mt-2 ml-auto flex w-fit flex-row items-start gap-2">
				<img src="/images/villa-connexion/09.webp" alt="" class="h-[290px] aspect-[3/4] object-cover" loading="lazy" />
			</div>

			<div id="vc-row5" class="mt-2 flex w-fit flex-row items-start gap-2">
				<img src="/images/villa-connexion/13.webp" alt="" class="w-[180px] aspect-[3/4] object-cover" loading="lazy" />
				<img src="/images/villa-connexion/12.webp" alt="" class="w-[180px] aspect-[3/4] object-cover" loading="lazy" />
				<img src="/images/villa-connexion/11.webp" alt="" class="w-[180px] aspect-[3/4] object-cover" loading="lazy" />
			</div>

			<div id="vc-row6" class="mt-2 ml-auto flex w-fit flex-row items-end gap-2">
				<video src="/videos/villa-connexion-14.mp4" class="h-[380px] aspect-[3/4] object-cover" autoplay loop muted playsinline></video>
				<img src="/images/villa-connexion/15qua.webp" alt="" class="w-[120px] aspect-[3/4] object-cover object-bottom" loading="lazy" />
			</div>

			<div id="vc-row7" class="mt-2 flex w-fit flex-row gap-2">
				<img src="/images/villa-connexion/17.webp" alt="" class="w-[190px] aspect-[3/4] object-cover" loading="lazy" />
				<img src="/images/villa-connexion/18.webp" alt="" class="w-[190px] aspect-[3/4] object-cover" loading="lazy" />
				<img src="/images/villa-connexion/19.webp" alt="" class="w-[190px] aspect-[3/4] object-cover" loading="lazy" />
			</div>

			<div id="vc-row8" class="mt-2 ml-auto flex w-fit flex-row items-end gap-2">
				<img src="/images/villa-connexion/16bis.webp" alt="" class="h-[350px] aspect-[3/4] object-cover" loading="lazy" />
				<video src="/videos/villa-connexion-22ter.mp4" class="w-[120px] aspect-[3/4] object-cover saturate-110" autoplay loop muted playsinline></video>
			</div>

			<a href="/projects/resort-life" class="mt-16 block pt-6" style="border-top: 0.5px solid #1c1c1c;">
				<p class="text-[0.76rem] font-[325] uppercase" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.08em; color: #8c8a84;">Next</p>
				<p class="mt-1 text-[calc(0.76rem+2pt)] font-[325] tabular-nums" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.15;">2/4<br />RESORT LIFE<br />stillness and light</p>
			</a>
		</main>

		<div class="js-blend-fixed absolute top-3 left-6 right-6 flex flex-row items-start">
			<a href="/" class="block text-[41px] leading-tight font-normal" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.05em; color: #fff; mix-blend-mode: difference; text-transform: uppercase;">senja studio</a>
		</div>
		<div class="absolute top-3 left-1/2 z-10 w-1/2 pointer-events-none">
			<p class="text-[0.76rem] font-[325]" style="margin-top: 7px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c; line-height: 1.15;">1/4<br />VILLA CONNEXION<br />intimate luxurious spaces</p>
		</div>
		<nav class="js-blend-fixed absolute right-6 flex flex-row text-[0.76rem] font-[325]" style="top: 17px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #fff; mix-blend-mode: difference;">
			<a href="/" class="nav-link active">projects</a><span>,&nbsp;</span><a href="/services" class="nav-link">services</a><span>,&nbsp;</span><a href="/about" class="nav-link">about</a><span>,&nbsp;</span><a href="/contact" class="nav-link">contact</a>
		</nav>
		<a href="/" class="fixed left-6 z-10 text-2xl font-normal" style="top: 84px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1c1c1c; text-decoration: none;">←</a>

		<Footer fixed={false} />
		<script>
			import { initHoverSoundVideos } from '../../scripts/video-hover-sound.js';
			initHoverSoundVideos();

			const blendFixedEls = Array.from(document.querySelectorAll('.js-blend-fixed')).map((el) => ({
				el,
				offset: parseFloat(getComputedStyle(el).top) || 0,
			}));
			const syncBlendFixed = () => {
				blendFixedEls.forEach(({ el, offset }) => {
					el.style.top = (window.scrollY + offset) + 'px';
				});
			};
			syncBlendFixed();
			window.addEventListener('scroll', syncBlendFixed, { passive: true });
			window.addEventListener('resize', syncBlendFixed);

			const alignRightEdgeTo = (el, targetX) => {
				const currentMR = parseFloat(getComputedStyle(el).marginRight) || 0;
				el.style.marginRight = (currentMR + (el.getBoundingClientRect().right - targetX)) + 'px';
			};
			const alignLeftEdgeTo = (el, targetX) => {
				const currentML = parseFloat(getComputedStyle(el).marginLeft) || 0;
				el.style.marginLeft = (currentML + (targetX - el.getBoundingClientRect().left)) + 'px';
			};
			const layoutRows = () => {
				const img1 = document.querySelector('img[src*="01.webp"]');
				const img5 = document.querySelector('img[src*="05.webp"]');
				const img15 = document.querySelector('img[src*="15qua.webp"]');
				const row2 = document.getElementById('vc-row2');
				const row4 = document.getElementById('vc-row4');
				const row5 = document.getElementById('vc-row5');
				const row6 = document.getElementById('vc-row6');
				const row7 = document.getElementById('vc-row7');
				const row8 = document.getElementById('vc-row8');
				if (img1 && row2) alignRightEdgeTo(row2, img1.getBoundingClientRect().left - 16);
				if (img5 && row4) alignRightEdgeTo(row4, img5.getBoundingClientRect().left);
				if (row4 && row5) alignLeftEdgeTo(row5, row4.getBoundingClientRect().right);
				const row5FirstImg = row5 && row5.querySelector('img');
				if (row5FirstImg && row6 && img15) {
					const rowGap = 8;
					const photo15Width = img15.getBoundingClientRect().width;
					alignRightEdgeTo(row6, row5FirstImg.getBoundingClientRect().left + rowGap + photo15Width);
				}
				if (img15 && row7) alignLeftEdgeTo(row7, img15.getBoundingClientRect().right);
				const img17 = row7 && row7.querySelector('img');
				const video22 = row8 && row8.querySelector('video');
				if (img17 && row8 && video22) {
					const rowGap = 8;
					const video22Width = video22.getBoundingClientRect().width;
					alignRightEdgeTo(row8, img17.getBoundingClientRect().left + rowGap + video22Width);
				}
			};
			layoutRows();
			window.addEventListener('resize', layoutRows);
			window.addEventListener('load', layoutRows);
		</script>
	</body>
</html>
