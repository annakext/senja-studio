---
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '../../styles/global.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>villa connexion — senja studio</title>
		<style>
			.nav-link { position: relative; }
			.nav-link:hover { color: #c2c2c2; }
			.nav-link.active { color: #1c1c1c; }
		</style>
	</head>
	<body>
		<div class="absolute top-4 left-12 z-10">
			<a href="/" class="block text-4xl leading-tight font-normal" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.05em; color: #1c1c1c; text-transform: uppercase;">senja studio</a>
		</div>
		<nav class="fixed top-4 left-1/2 right-6 z-10 flex flex-row items-center justify-between text-sm font-[325]" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c;">
			<a href="/" class="nav-link active">projects</a>
			<a href="/services" class="nav-link">services</a>
			<a href="/about" class="nav-link">about</a>
			<a href="/contact" class="nav-link">contact</a>
		</nav>

		<a href="/" class="absolute top-4 right-6 z-10 text-lg leading-tight font-normal text-[#1c1c1c] transition-colors hover:text-neutral-300" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">✕</a>

		<main class="min-h-screen px-6 pb-24 pt-32">
			<div class="mx-auto max-w-3xl">
				<div class="mb-8 flex flex-row items-baseline justify-between" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c;">
					<div>
						<h1 class="text-2xl font-normal">VILLA CONNEXION</h1>
						<p class="text-sm font-[325]">intimate luxurious spaces</p>
					</div>
					<p class="text-sm font-[325] tabular-nums">1/4</p>
				</div>
				<img src="/images/projects-photo-5.jpg?v=2" alt="Villa Connexion" class="aspect-[4/5] w-full max-w-xl object-cover" />
			</div>
		</main>
	</body>
</html>
