---
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, viewport-fit=cover" />
		<meta name="theme-color" content="#1c1c1c" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital@0;1&display=swap" rel="stylesheet" />
		<title>services — SENJA STUDIO</title>
		<meta name="description" content="Creative direction, brand consulting and visual content production for hospitality and lifestyle brands — from concept and shot lists to photography, film, UGC and editing." />
		<style>
			@media (max-width: 767px) {
				#site-header, nav, #ig-icon { transform: translateY(66px); }
			}
			.nav-link { position: relative; text-decoration: none; }
			.nav-link::after { content: ""; position: absolute; left: 0; bottom: 1px; width: 0; height: 1px; background: currentColor; transition: width 0.3s ease; }
			.nav-link:hover::after { width: 100%; }
			.nav-link.active { color: #1c1c1c; }
			.nav-link.active::after { width: 100%; }
			:global(html) { scrollbar-width: none; }
			:global(html)::-webkit-scrollbar { display: none; }
		</style>
	</head>
	<body>
		<div class="fixed top-0 left-0 right-0 h-[54px] bg-[#1c1c1c] md:hidden"></div>
		<div id="site-header" class="fixed top-3 left-6 right-6 z-10 flex flex-row items-start">
			<a id="site-logo" href="/" class="block text-[41px] leading-tight font-normal" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.05em; color: #1c1c1c; text-transform: uppercase;">senja studio</a>
		</div>
		<nav class="fixed right-6 z-10 flex flex-row text-[0.76rem] font-[325]" style="top: 17px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c;">
			<a href="/" class="nav-link">projects</a><span>,&nbsp;</span><a href="/services" class="nav-link active">services</a><span>,&nbsp;</span><a href="/about" class="nav-link">about</a><span>,&nbsp;</span><a href="/contact" class="nav-link">contact</a>
		</nav>
		<a id="ig-icon" href="https://www.instagram.com/roll.bysenja/" target="_blank" rel="noopener noreferrer" class="fixed z-10" style="top: 44px; right: 23.5px;" aria-label="Instagram">
			<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
				<rect x="2" y="2" width="20" height="20" rx="5" stroke="#1c1c1c" stroke-width="2" />
				<circle cx="12" cy="12" r="5" stroke="#1c1c1c" stroke-width="2" />
				<circle cx="18" cy="6" r="1.3" fill="#1c1c1c" />
			</svg>
		</a>

		<a href="/" class="fixed left-6 z-10 text-2xl font-normal" style="top: 84px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1c1c1c; text-decoration: none;">←</a>


		<main class="min-h-screen px-6 pb-24 pt-28">
			<div class="ml-[29vw] max-w-xl">
				<h1 class="relative block text-[25.33px] leading-tight font-normal" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c;">services</h1>
				<div class="mt-6 space-y-4 text-justify text-[0.8rem] font-[325] leading-relaxed" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0.02em; color: #1c1c1c;">
					<p>SENJA STUDIO works across creative direction, brand consulting and visual content production for hospitality and lifestyle brands. Projects can be developed from the ground up or tailored to a specific need, from a complete visual direction to a small collection of images and short form videos.</p>

					<p class="pt-4"><span class="inline-block font-medium text-[0.89rem] uppercase">visual production</span></p>

					<div class="max-w-[20rem] space-y-4">
						<div class="space-y-0.5 pt-4">
							<p class="text-sm font-medium" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;"><span class="pr-3">01</span>pre production</p>
							<p>Concept and Moodboard<br />Shot List<br />Creative Direction</p>
						</div>

						<div class="space-y-0.5">
							<p class="text-sm font-medium" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;"><span class="pr-3">02</span>production</p>
							<p>Photography · Film · UGC<br />Studio &amp; On Location Art Direction</p>
						</div>

						<div class="space-y-0.5">
							<p class="text-sm font-medium" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;"><span class="pr-3">03</span>post production</p>
							<p>Photo Editing &amp; Retouching<br />Film Editing, Color Grading &amp; Sound Design</p>
						</div>
					</div>

					<div class="space-y-0.5">
						<p class="text-sm font-medium" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">deliverables</p>
						<p>Reels · Stories · Feed · TikTok · Paid Ads · Website Imagery · Editorial · Lookbook · Campaign</p>
						<p class="pt-2">Content is delivered in the formats each project needs, from a handful of social assets to a complete visual library. All content delivered promptly with full usage rights included. Ready to post.</p>
					</div>

					<div class="space-y-0.5 pt-4">
						<p class="text-sm font-medium" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1c1c1c;">BRAND CONSULTING</p>
						<p class="pt-4">Visual Identity Audit<br />Content Strategy<br />Social Media Direction</p>
						<p class="pt-2">For brands looking for more than production, we offer focused creative and brand consulting to help clarify their visual identity and content direction.</p>
					</div>
				</div>
			</div>
		</main>

		<Footer />
		<script>
			import { initResponsiveLogo } from '../scripts/responsive-logo.js';
			initResponsiveLogo();
		</script>
	</body>
</html>
